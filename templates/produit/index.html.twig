{% extends 'base.html.twig' %}
{% block title %}NOVAWIN - Gestion des Produits{% endblock %}
{% block page_title %}Gestion des Produits{% endblock %}
{% block page_subtitle %}Vos articles en ligne.{% endblock %}

{% block body %}
<div class="container-fluid p-0">

    {% for message in app.flashes('success') %}
        <div class="alert alert-success"
             style="border-radius:12px;border:none;background:rgba(40,167,69,0.12);color:#28a745;">
            <i class="fas fa-check-circle me-2"></i>{{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger"
             style="border-radius:12px;border:none;background:rgba(220,53,69,0.12);color:#dc3545;">
            <i class="fas fa-exclamation-circle me-2"></i>{{ message }}
        </div>
    {% endfor %}

    <!-- ═══════════════════════════════════════
         EN-TÊTE avec bouton Nouveau produit (split)
    ═══════════════════════════════════════ -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
        <div>
            <h2 class="mb-1" style="color:var(--text-primary);">
                <i class="fas fa-box me-2" style="color:var(--emerald);"></i>Liste des Produits
                <span id="badgeCount" class="badge rounded-pill ms-2"
                      style="background:var(--emerald);color:#0b1329;font-size:0.75rem;">
                    {{ produits.getTotalItemCount() }}
                </span>
            </h2>
            <p class="mb-0" style="color:var(--text-secondary);">
                <i class="fas fa-info-circle me-1"></i> Gérez votre catalogue de produits
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <!-- BOUTON EXPORT -->
            <button class="btn px-4 py-2 fw-semibold"
                    onclick="openExportModal()"
                    style="background:rgba(100,180,255,0.12);color:#64b4ff;border:1.5px solid rgba(100,180,255,0.3);border-radius:12px;">
                <i class="fas fa-file-export me-2"></i> Exporter
            </button>

            <!-- BOUTON NOUVEAU PRODUIT (split) -->
            <div class="nova-split-btn" id="newProductBtn">
                <div class="nova-split-main" onclick="window.location.href='{{ path('app_produit_new') }}'">
                    <i class="fas fa-plus"></i>
                    <span>Nouveau produit</span>
                </div>
                <div class="nova-split-arrow" onclick="toggleMenu('newProductMenu')">
                    <i class="fas fa-chevron-down"></i>
                </div>
                <div class="nova-split-menu" id="newProductMenu">
                    <div class="nova-split-menu-item" onclick="window.location.href='{{ path('app_produit_new') }}'">
                        <div class="nova-split-menu-icon" style="background:rgba(0,255,163,0.12);">
                            <i class="fas fa-pen" style="color:var(--emerald);"></i>
                        </div>
                        <div>
                            <div class="nova-split-menu-label">Saisie manuelle</div>
                            <div class="nova-split-menu-desc">Créer un produit via le formulaire</div>
                        </div>
                    </div>
                    <div class="nova-split-menu-divider"></div>
                    <div class="nova-split-menu-item" onclick="openImportModal()">
                        <div class="nova-split-menu-icon" style="background:rgba(100,180,255,0.12);">
                            <i class="fas fa-file-import" style="color:#64b4ff;"></i>
                        </div>
                        <div>
                            <div class="nova-split-menu-label">Importer une liste</div>
                            <div class="nova-split-menu-desc">CSV, Excel ou JSON</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres -->
    <div class="card border-0 shadow-sm rounded-4 mb-3"
         style="background:var(--card-bg-light);border:1px solid var(--border-color);">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">

                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text"
                              style="background:var(--bg-body);border-color:var(--border-color);color:var(--text-secondary);">
                            <i class="fas fa-search"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control"
                               placeholder="Rechercher par nom ou SKU..."
                               style="background:var(--bg-body);border-color:var(--border-color);
                                      color:var(--text-primary);border-radius:0 10px 10px 0;">
                    </div>
                </div>

                <div class="col-12 col-md-3">
                    <div class="input-group">
                        <span class="input-group-text"
                              style="background:var(--bg-body);border-color:var(--border-color);color:var(--text-secondary);">
                            <i class="fas fa-filter"></i>
                        </span>
                        <select id="filterCategorie" class="form-select"
                                style="background:var(--bg-body);border-color:var(--border-color);
                                       color:var(--text-primary);border-radius:0 10px 10px 0;">
                            <option value="">Toutes les catégories</option>
                            {% for cat in categories %}
                                <option value="{{ cat.nom|lower }}">{{ cat.nom }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="col-12 col-md-3">
                    <div class="input-group">
                        <span class="input-group-text"
                              style="background:var(--bg-body);border-color:var(--border-color);color:var(--text-secondary);">
                            <i class="fas fa-sort"></i>
                        </span>
                        <select id="sortSelect" class="form-select"
                                style="background:var(--bg-body);border-color:var(--border-color);
                                       color:var(--text-primary);border-radius:0 10px 10px 0;">
                            <option value="nom-asc">Nom A → Z</option>
                            <option value="nom-desc">Nom Z → A</option>
                            <option value="sku-asc">SKU A → Z</option>
                            <option value="sku-desc">SKU Z → A</option>
                            <option value="date-desc">Plus récent</option>
                            <option value="date-asc">Plus ancien</option>
                        </select>
                    </div>
                </div>

                <div class="col-12 col-md-2 text-end">
                    <button id="resetFilters" class="btn btn-sm"
                            style="display:none;background:transparent;color:var(--text-secondary);
                                   border:1px solid var(--border-color);border-radius:8px;">
                        <i class="fas fa-times me-1"></i> Réinitialiser
                    </button>
                </div>
            </div>
            <small id="resultCount" class="d-block mt-2" style="color:var(--text-secondary);"></small>
        </div>
    </div>

    <!-- Tableau -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden"
         style="background:var(--card-bg-light);border:1px solid var(--border-color);">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="color:var(--text-primary);">
                    <thead style="background:var(--bg-body);">
                        <tr>
                            <th class="px-4 py-3 text-uppercase small fw-bold"
                                style="font-size:0.65rem;letter-spacing:1px;color:var(--text-secondary);">SKU</th>
                            <th class="px-4 py-3 text-uppercase small fw-bold"
                                style="font-size:0.65rem;letter-spacing:1px;color:var(--text-secondary);">NOM DU PRODUIT</th>
                            <th class="px-4 py-3 text-uppercase small fw-bold"
                                style="font-size:0.65rem;letter-spacing:1px;color:var(--text-secondary);">CATÉGORIE</th>
                            <th class="px-4 py-3 text-uppercase small fw-bold"
                                style="font-size:0.65rem;letter-spacing:1px;color:var(--text-secondary);">STATUT</th>
                            <th class="px-4 py-3 text-uppercase small fw-bold"
                                style="font-size:0.65rem;letter-spacing:1px;color:var(--text-secondary);">DATE CRÉATION</th>
                            <th class="px-4 py-3 text-uppercase small fw-bold text-end"
                                style="font-size:0.65rem;letter-spacing:1px;color:var(--text-secondary);">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody id="produitTableBody">
                        {% if produits.items is empty %}
                            <tr>
                                <td colspan="6" class="text-center py-5" style="color:var(--text-secondary);">
                                    <i class="fas fa-box-open fa-3x d-block mb-3" style="opacity:0.5;"></i>
                                    <p class="mb-0">Aucun produit enregistré pour le moment.</p>
                                </td>
                            </tr>
                        {% else %}
                            {% for produit in produits %}
                                <tr class="border-bottom produit-row"
                                    style="border-color:var(--border-color) !important;"
                                    data-nom="{{ produit.nom|lower }}"
                                    data-sku="{{ produit.sku|lower }}"
                                    data-categorie="{{ produit.categorie.nom|lower }}"
                                    data-statut="{{ produit.statut }}"
                                    data-date="{{ produit.dateCreation|date('Y-m-d') }}">

                                    <td class="px-4 py-3">
                                        <span class="fw-semibold"
                                              style="color:var(--emerald);font-family:monospace;">
                                            {{ produit.sku }}
                                        </span>
                                    </td>
                                    <td class="px-4 py-3" style="font-weight:500;">
                                        <div class="d-flex align-items-center gap-3">
                                            {% if produit.imageUrl %}
                                                <img src="{{ produit.imageUrl }}" alt="{{ produit.nom }}"
                                                     style="width:36px;height:36px;object-fit:cover;
                                                            border-radius:8px;border:1px solid var(--border-color);">
                                            {% else %}
                                                <div style="width:36px;height:36px;border-radius:8px;
                                                            background:var(--bg-body);border:1px solid var(--border-color);
                                                            display:flex;align-items:center;justify-content:center;">
                                                    <i class="fas fa-image"
                                                       style="color:var(--text-secondary);font-size:0.7rem;"></i>
                                                </div>
                                            {% endif %}
                                            {{ produit.nom }}
                                        </div>
                                    </td>
                                    <td class="px-4 py-3" style="color:var(--text-secondary);">
                                        {{ produit.categorie.nom }}
                                    </td>
                                    <td class="px-4 py-3">
                                        {% if produit.statut == 'actif' %}
                                            <span class="badge rounded-pill px-3 py-2"
                                                  style="background:rgba(40,167,69,0.15);color:#28a745;">
                                                <i class="fas fa-circle me-1" style="font-size:0.5rem;"></i>Actif
                                            </span>
                                        {% elseif produit.statut == 'rupture' %}
                                            <span class="badge rounded-pill px-3 py-2"
                                                  style="background:rgba(220,53,69,0.15);color:#dc3545;">
                                                <i class="fas fa-circle me-1" style="font-size:0.5rem;"></i>Rupture
                                            </span>
                                        {% else %}
                                            <span class="badge rounded-pill px-3 py-2"
                                                  style="background:rgba(108,117,125,0.15);color:#6c757d;">
                                                <i class="fas fa-circle me-1" style="font-size:0.5rem;"></i>Inactif
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="px-4 py-3"
                                        style="color:var(--text-secondary);font-size:0.85rem;">
                                        {{ produit.dateCreation|date('d/m/Y') }}
                                    </td>
                                    <td class="px-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="{{ path('app_produit_show', {'id': produit.id}) }}"
                                               class="btn btn-sm rounded-circle"
                                               style="width:34px;height:34px;border:1.5px solid var(--border-color);
                                                      color:var(--text-secondary);background:transparent;"
                                               onmouseover="this.style.borderColor='var(--emerald)';this.style.color='var(--emerald)';"
                                               onmouseout="this.style.borderColor='var(--border-color)';this.style.color='var(--text-secondary)';"
                                               title="Voir">
                                                <i class="fas fa-eye" style="font-size:0.8rem;"></i>
                                            </a>
                                            <a href="{{ path('app_produit_edit', {'id': produit.id}) }}"
                                               class="btn btn-sm rounded-circle"
                                               style="width:34px;height:34px;border:1.5px solid var(--border-color);
                                                      color:var(--text-secondary);background:transparent;"
                                               onmouseover="this.style.borderColor='var(--emerald)';this.style.color='var(--emerald)';"
                                               onmouseout="this.style.borderColor='var(--border-color)';this.style.color='var(--text-secondary)';"
                                               title="Modifier">
                                                <i class="fas fa-pen" style="font-size:0.8rem;"></i>
                                            </a>
                                            <form action="{{ path('app_produit_delete', {'id': produit.id}) }}"
                                                  method="POST" class="d-inline">
                                                <input type="hidden" name="_token"
                                                       value="{{ csrf_token('delete' ~ produit.id) }}">
                                                <button type="submit" class="btn btn-sm rounded-circle delete-btn"
                                                        style="width:34px;height:34px;border:1.5px solid var(--border-color);
                                                               color:var(--text-secondary);background:transparent;"
                                                        onmouseover="this.style.borderColor='#dc3545';this.style.color='#dc3545';"
                                                        onmouseout="this.style.borderColor='var(--border-color)';this.style.color='var(--text-secondary)';"
                                                        data-produit-name="{{ produit.nom }}"
                                                        title="Supprimer">
                                                    <i class="fas fa-trash" style="font-size:0.8rem;"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>

                <div id="noResultRow" class="text-center py-5"
                     style="display:none;color:var(--text-secondary);">
                    <i class="fas fa-search fa-3x d-block mb-3" style="opacity:0.4;"></i>
                    <p class="mb-0">Aucun produit ne correspond à votre recherche.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    {% if produits.pageCount > 1 %}
    <div class="d-flex justify-content-center mt-4">
        <nav>
            <ul class="pagination" style="gap:6px;">
                {% if produits.currentPageNumber > 1 %}
                    <li class="page-item">
                        <a class="page-link"
                           href="{{ path('app_produit_index', {'page': produits.currentPageNumber - 1}) }}"
                           style="border-radius:10px;border:1.5px solid var(--border-color);
                                  background:var(--card-bg-light);color:var(--text-secondary);padding:0.5rem 0.9rem;">
                            <i class="fas fa-chevron-left" style="font-size:0.75rem;"></i>
                        </a>
                    </li>
                {% endif %}
                {% for i in 1..produits.pageCount %}
                    <li class="page-item">
                        <a class="page-link"
                           href="{{ path('app_produit_index', {'page': i}) }}"
                           style="border-radius:10px;padding:0.5rem 0.9rem;
                                  {% if i == produits.currentPageNumber %}
                                      background:var(--emerald);color:#0b1329;border:1.5px solid var(--emerald);font-weight:700;
                                  {% else %}
                                      border:1.5px solid var(--border-color);background:var(--card-bg-light);color:var(--text-secondary);
                                  {% endif %}">
                            {{ i }}
                        </a>
                    </li>
                {% endfor %}
                {% if produits.currentPageNumber < produits.pageCount %}
                    <li class="page-item">
                        <a class="page-link"
                           href="{{ path('app_produit_index', {'page': produits.currentPageNumber + 1}) }}"
                           style="border-radius:10px;border:1.5px solid var(--border-color);
                                  background:var(--card-bg-light);color:var(--text-secondary);padding:0.5rem 0.9rem;">
                            <i class="fas fa-chevron-right" style="font-size:0.75rem;"></i>
                        </a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    </div>
    <p class="text-center mt-2" style="color:var(--text-secondary);font-size:0.82rem;">
        Page {{ produits.currentPageNumber }} sur {{ produits.pageCount }}
        — {{ produits.getTotalItemCount() }} produit{{ produits.getTotalItemCount() > 1 ? 's' : '' }} au total
    </p>
    {% endif %}

</div>

<!-- ═══════════════════════════════════
     MODAL EXPORT
═══════════════════════════════════ -->
<div class="modal fade" id="exportModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content rounded-4 border-0"
             style="background:var(--card-bg-light);border:1px solid var(--border-color) !important;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" style="color:var(--text-primary);">
                    <i class="fas fa-file-export me-2" style="color:#64b4ff;"></i>
                    Exporter les produits
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="filter:invert(1);opacity:0.5;"></button>
            </div>
            <div class="modal-body pt-3">

                <!-- Filtres d'export -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-semibold" style="color:var(--text-secondary);">
                            <i class="fas fa-toggle-on me-1"></i> Statut
                        </label>
                        <select id="exportStatut" class="form-select"
                                style="background:var(--bg-body);border-color:var(--border-color);
                                       color:var(--text-primary);border-radius:10px;">
                            <option value="">Tous les statuts</option>
                            <option value="actif">Actif</option>
                            <option value="inactif">Inactif</option>
                            <option value="rupture">Rupture</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-semibold" style="color:var(--text-secondary);">
                            <i class="fas fa-tags me-1"></i> Catégorie
                        </label>
                        <select id="exportCategorie" class="form-select"
                                style="background:var(--bg-body);border-color:var(--border-color);
                                       color:var(--text-primary);border-radius:10px;">
                            <option value="">Toutes les catégories</option>
                            {% for cat in categories %}
                                <option value="{{ cat.id }}">{{ cat.nom }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-semibold" style="color:var(--text-secondary);">
                            <i class="fas fa-search me-1"></i> Recherche
                        </label>
                        <input type="text" id="exportSearch" class="form-control"
                               placeholder="Filtrer par nom ou SKU..."
                               style="background:var(--bg-body);border-color:var(--border-color);
                                      color:var(--text-primary);border-radius:10px;">
                    </div>

                    <div class="col-12 col-md-2 d-flex align-items-end">
                        <div class="w-100 text-center" style="color:var(--text-secondary);font-size:0.75rem;">
                            <i class="fas fa-sync-alt fa-fw me-1" style="color:#64b4ff;"></i>
                            Mise à jour automatique
                        </div>
                    </div>
                </div>

                <!-- Résumé des filtres -->
                <div id="exportFiltersSummary" class="small mb-3" style="color:var(--text-secondary);display:none;">
                    <i class="fas fa-info-circle me-1"></i>
                    Filtres actifs : <span id="exportFiltersText"></span>
                </div>

                <!-- Résultats de la prévisualisation -->
                <div id="exportPreviewContainer">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-semibold" style="color:var(--text-primary);">
                            <i class="fas fa-list me-1"></i> Produits à exporter
                            <span id="exportCount" class="badge rounded-pill ms-2"
                                  style="background:var(--emerald);color:#0b1329;">0</span>
                        </span>
                        <span class="small" style="color:var(--text-secondary);">
                            <i class="fas fa-info-circle me-1"></i>
                            <span id="exportTotalDisplay"></span>
                        </span>
                    </div>
                    <div class="table-responsive" style="max-height:300px;overflow-y:auto;">
                        <table class="table table-sm table-hover" style="color:var(--text-primary);font-size:0.85rem;">
                            <thead style="position:sticky;top:0;background:var(--bg-body);z-index:10;">
                                <tr>
                                    <th style="width:15%;">SKU</th>
                                    <th style="width:35%;">Nom</th>
                                    <th style="width:20%;">Catégorie</th>
                                    <th style="width:15%;">Statut</th>
                                    <th style="width:15%;">Date</th>
                                </tr>
                            </thead>
                            <tbody id="exportPreviewBody">
                            </tbody>
                        </table>
                    </div>
                    <div id="exportLoading" class="text-center py-3" style="color:var(--text-secondary);">
                        <i class="fas fa-spinner fa-spin me-2"></i> Chargement...
                    </div>
                    <div id="exportNoResult" class="text-center py-3" style="color:var(--text-secondary);display:none;">
                        <i class="fas fa-search fa-2x d-block mb-2" style="opacity:0.4;"></i>
                        <p class="mb-0">Aucun produit ne correspond à ces critères.</p>
                    </div>
                </div>

                <!-- Choix du format et bouton de téléchargement -->
                <div class="mt-4 pt-3" style="border-top:1px solid var(--border-color);">
                    <div class="row g-3 align-items-center">
                        <div class="col-12 col-md-6">
                            <label class="form-label small fw-semibold" style="color:var(--text-secondary);">
                                <i class="fas fa-download me-1"></i> Format d'export
                            </label>
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="btn btn-sm export-format-btn "
                                        data-format="csv"
                                          style="background:transparent;color:var(--text-secondary);
                                               border:1.5px solid var(--border-color);border-radius:8px;padding:0.4rem 1rem;">
                                    <i class="fas fa-file-csv"></i> CSV
                                </button>
                                <button type="button" class="btn btn-sm export-format-btn"
                                        data-format="excel"
                                        style="background:transparent;color:var(--text-secondary);
                                               border:1.5px solid var(--border-color);border-radius:8px;padding:0.4rem 1rem;">
                                    <i class="fas fa-file-excel"></i> Excel
                                </button>
                                <button type="button" class="btn btn-sm export-format-btn"
                                        data-format="json"
                                        style="background:transparent;color:var(--text-secondary);
                                               border:1.5px solid var(--border-color);border-radius:8px;padding:0.4rem 1rem;">
                                    <i class="fas fa-file-code"></i> JSON
                                </button>
                                <button type="button" class="btn btn-sm export-format-btn"
                                        data-format="pdf"
                                        style="background:transparent;color:var(--text-secondary);
                                               border:1.5px solid var(--border-color);border-radius:8px;padding:0.4rem 1rem;">
                                    <i class="fas fa-file-pdf"></i> PDF
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 text-md-end">
                            <button type="button" id="downloadExportBtn" class="btn px-4 py-2 fw-semibold"
                                    style="background:var(--emerald);color:#0b1329;border:none;border-radius:10px;"
                                    disabled>
                                <i class="fas fa-download me-1"></i> Télécharger
                            </button>
                            <button type="button" class="btn px-4 py-2 ms-2"
                                    data-bs-dismiss="modal"
                                    style="background:transparent;border:1.5px solid var(--border-color);
                                           color:var(--text-secondary);border-radius:10px;">
                                Fermer
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

