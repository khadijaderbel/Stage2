<script>
document.addEventListener('DOMContentLoaded', function () {

    /* ══════════════════════════════
       FILTRES TABLEAU
    ══════════════════════════════ */
    const searchInput     = document.getElementById('searchInput');
    const filterCategorie = document.getElementById('filterCategorie');
    const sortSelect      = document.getElementById('sortSelect');
    const tbody           = document.getElementById('produitTableBody');
    const noResult        = document.getElementById('noResultRow');
    const resultCount     = document.getElementById('resultCount');
    const badgeCount      = document.getElementById('badgeCount');
    const resetBtn        = document.getElementById('resetFilters');
    const totalRows       = document.querySelectorAll('.produit-row').length;

    function applyFilters() {
        const search    = searchInput.value.trim().toLowerCase();
        const categorie = filterCategorie.value.toLowerCase();
        const sort      = sortSelect.value;

        let rows = Array.from(document.querySelectorAll('.produit-row'));
        rows.forEach(row => {
            const nom = row.dataset.nom || '';
            const sku = row.dataset.sku || '';
            const cat = row.dataset.categorie || '';
            const matchSearch    = !search    || nom.includes(search) || sku.includes(search);
            const matchCategorie = !categorie || cat === categorie;
            row.style.display = (matchSearch && matchCategorie) ? '' : 'none';
        });

        const visible = rows.filter(r => r.style.display !== 'none');
        visible.sort((a, b) => {
            switch (sort) {
                case 'nom-asc':   return (a.dataset.nom||'').localeCompare(b.dataset.nom||'', 'fr');
                case 'nom-desc':  return (b.dataset.nom||'').localeCompare(a.dataset.nom||'', 'fr');
                case 'sku-asc':   return (a.dataset.sku||'').localeCompare(b.dataset.sku||'', 'fr');
                case 'sku-desc':  return (b.dataset.sku||'').localeCompare(a.dataset.sku||'', 'fr');
                case 'date-asc':  return (a.dataset.date||'').localeCompare(b.dataset.date||'');
                case 'date-desc': return (b.dataset.date||'').localeCompare(a.dataset.date||'');
                default: return 0;
            }
        });
        visible.forEach(row => tbody.appendChild(row));

        const count = visible.length;
        badgeCount.textContent = count;
        noResult.style.display = count === 0 ? '' : 'none';
        resultCount.textContent = count === totalRows
            ? `${count} produit${count > 1 ? 's' : ''} sur cette page`
            : `${count} résultat${count > 1 ? 's' : ''} sur ${totalRows}`;
        resetBtn.style.display = (search || categorie) ? 'inline-block' : 'none';
    }

    searchInput.addEventListener('input',      () => { filterCategorie.value = ''; applyFilters(); });
    filterCategorie.addEventListener('change', () => { searchInput.value = '';     applyFilters(); });
    sortSelect.addEventListener('change', applyFilters);
    resetBtn.addEventListener('click', () => {
        searchInput.value = ''; filterCategorie.value = ''; sortSelect.value = 'nom-asc';
        applyFilters();
    });
    applyFilters();

    /* ══════════════════════════════
       SUPPRESSION SWEETALERT
    ══════════════════════════════ */
    document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            const form = this.closest('form');
            const name = this.dataset.produitName;
            Swal.fire({
                title: 'Confirmer la suppression',
                html: `<div style="text-align:left;">
                    <p style="color:var(--text-secondary);">
                        Supprimer <strong style="color:var(--text-primary);">${name}</strong> ?
                    </p>
                    <p style="font-size:0.9rem;color:var(--text-secondary);">
                        <i class="fas fa-exclamation-triangle" style="color:#dc3545;"></i>
                        Cette action est <strong style="color:#dc3545;">irréversible</strong>.
                    </p>
                </div>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-trash me-1"></i> Supprimer',
                cancelButtonText: '<i class="fas fa-times me-1"></i> Annuler',
                background: getComputedStyle(document.documentElement).getPropertyValue('--card-bg-light').trim() || '#fff',
                color: getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#1a2744',
                customClass: {
                    popup: 'rounded-4',
                    confirmButton: 'btn btn-danger px-4 py-2 rounded-pill',
                    cancelButton: 'btn btn-secondary px-4 py-2 rounded-pill'
                }
            }).then(r => { if (r.isConfirmed) form.submit(); });
        });
    });

    /* ══════════════════════════════
       FERMER MENUS AU CLIC EXTÉRIEUR
    ══════════════════════════════ */
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.nova-split-btn')) {
            document.querySelectorAll('.nova-split-menu.open').forEach(m => {
                m.classList.remove('open');
                const arrow = m.closest('.nova-split-btn')?.querySelector('.nova-split-arrow i');
                if (arrow) arrow.style.transform = '';
            });
        }
    });

    /* ══════════════════════════════
       TOGGLE MENU SPLIT
    ══════════════════════════════ */
    window.toggleMenu = function(menuId) {
        const menu   = document.getElementById(menuId);
        const isOpen = menu.classList.contains('open');

        document.querySelectorAll('.nova-split-menu.open').forEach(m => {
            m.classList.remove('open');
            const arrow = m.closest('.nova-split-btn')?.querySelector('.nova-split-arrow i');
            if (arrow) arrow.style.transform = '';
        });

        if (!isOpen) {
            menu.classList.add('open');
            const arrow = menu.closest('.nova-split-btn')?.querySelector('.nova-split-arrow i');
            if (arrow) arrow.style.transform = 'rotate(180deg)';
        }
    };

    /* ══════════════════════════════
       TOGGLE RÈGLES D'IMPORT
    ══════════════════════════════ */
    window.toggleImportRules = function() {
        const content  = document.getElementById('importRulesContent');
        const toggle   = document.getElementById('importRulesToggle');
        content.classList.toggle('open');
        toggle.classList.toggle('open');
    };

    /* ══════════════════════════════
       EXPORT ORBIT
    ══════════════════════════════ */
    let currentExportFormat = 'csv';

    window.selectExportFormat = function(format, label, color) {
        currentExportFormat = format;
        const displayEl = document.getElementById('orbitFormatDisplay');
        if (displayEl) displayEl.textContent = label.toUpperCase();

        document.querySelectorAll('.orbit-icon').forEach((icon, index) => {
            icon.classList.toggle('active', ['csv','excel','json','pdf'][index] === format);
        });

        const btn = document.getElementById('exportOrbitBtn');
        if (btn) {
            btn.style.background = color;
            btn.style.color = format === 'pdf' ? 'white' : '#0b1329';
        }
    };

    const orbitBtn = document.getElementById('exportOrbitBtn');
    if (orbitBtn) {
        orbitBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            const labels = { csv: 'CSV', excel: 'Excel', json: 'JSON', pdf: 'PDF' };
            const colors = { csv: '#00ffa3', excel: '#1d6f42', json: '#f0a500', pdf: '#dc3545' };
            triggerExport(currentExportFormat, labels[currentExportFormat], colors[currentExportFormat]);
        });
    }

    function buildExportUrl(format) {
        const params = new URLSearchParams({ format });
        const statut    = document.getElementById('exportStatut').value;
        const categorie = document.getElementById('exportCategorie').value;
        const search    = document.getElementById('exportSearch').value.trim();
        if (statut)    params.append('statut', statut);
        if (categorie) params.append('categorie', categorie);
        if (search)    params.append('search', search);
        return '{{ path("app_produit_export") }}?' + params.toString();
    }

    function triggerExport(format, label, color) {
        const statut    = document.getElementById('exportStatut').value;
        const categorie = document.getElementById('exportCategorie').value;
        const search    = document.getElementById('exportSearch').value.trim();

        const filterLabels = [];
        if (statut)    filterLabels.push(`statut : <strong>${statut}</strong>`);
        if (categorie) filterLabels.push(`catégorie sélectionnée`);
        if (search)    filterLabels.push(`recherche : <strong>${search}</strong>`);

        const desc = filterLabels.length > 0
            ? `Filtres : ${filterLabels.join(', ')}.`
            : `<strong>Tous les produits</strong> seront exportés.`;

        const icons = { csv: '📄', excel: '📊', json: '🔧', pdf: '🖨️' };

        Swal.fire({
            title: `${icons[format] || '📁'} Exporter en ${label}`,
            html: `<div style="text-align:left;padding:8px 0;"><p style="color:var(--text-secondary);">${desc}</p></div>`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: `<i class="fas fa-download me-1"></i> Télécharger ${label}`,
            cancelButtonText: 'Annuler',
            confirmButtonColor: color || '#00ffa3',
            cancelButtonColor: '#6c757d',
            background: getComputedStyle(document.documentElement).getPropertyValue('--card-bg-light').trim() || '#fff',
            color: getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#1a2744',
            customClass: {
                popup: 'rounded-4',
                confirmButton: 'btn fw-semibold px-4 py-2 rounded-pill',
                cancelButton: 'btn btn-secondary px-4 py-2 rounded-pill'
            }
        }).then(result => {
            if (result.isConfirmed) window.location.href = buildExportUrl(format);
        });
    }

    /* ══════════════════════════════
       MODAL IMPORT
    ══════════════════════════════ */
    window.openImportModal = function() {
        document.getElementById('importForm').reset();
        document.getElementById('importFileName').style.display = 'none';
        document.getElementById('importFileName').innerHTML = '';
        const btn = document.getElementById('importSubmitBtn');
        btn.disabled = true;
        btn.style.opacity = '0.5';
        btn.innerHTML = '<i class="fas fa-upload me-1"></i> Importer';

        const modal = new bootstrap.Modal(document.getElementById('importModal'));
        modal.show();
    };

    window.handleFileSelect = function(input) {
        if (input.files && input.files[0]) {
            showImportFile(input.files[0]);
        }
    };

    window.handleDrop = function(event) {
        event.preventDefault();
        const file = event.dataTransfer.files[0];
        if (file) {
            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);
            document.getElementById('importFile').files = dataTransfer.files;
            showImportFile(file);
        }
        event.currentTarget.style.borderColor = 'var(--border-color)';
    };

    function showImportFile(file) {
        const allowed = ['csv', 'xlsx', 'xls', 'json'];
        const ext = file.name.split('.').pop().toLowerCase();

        if (!allowed.includes(ext)) {
            Swal.fire({
                title: 'Format non supporté',
                text: `Le fichier « ${file.name} » n'est pas accepté. Utilisez CSV, Excel (.xlsx/.xls) ou JSON.`,
                icon: 'error',
                confirmButtonColor: '#dc3545',
                background: getComputedStyle(document.documentElement).getPropertyValue('--card-bg-light').trim() || '#fff',
                color: getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#1a2744',
            });
            return;
        }

        const nameDiv  = document.getElementById('importFileName');
        const submitBtn = document.getElementById('importSubmitBtn');
        nameDiv.style.display = 'block';
        nameDiv.innerHTML = `<i class="fas fa-file-check me-1"></i> ${file.name} (${(file.size / 1024).toFixed(1)} Ko)`;
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
    }

    /* ══════════════════════════════
       GESTION DE L'IMPORT AVEC SWEETALERT
    ══════════════════════════════ */
    document.getElementById('importForm').addEventListener('submit', function(e) {
        e.preventDefault();

        const formData = new FormData(this);
        const submitBtn = document.getElementById('importSubmitBtn');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Importation...';

        fetch(this.action, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            // Gérer les catégories manquantes
            if (data.action === 'categories_manquantes') {
                const categoriesList = data.categoriesInconnues.map(c =>
                    `<li style="margin:4px 0;color:var(--text-secondary);">📁 ${c}</li>`
                ).join('');

                Swal.fire({
                    title: '🏷️ Catégories manquantes',
                    html: `
                        <div style="text-align:left;padding:4px 0;">
                            <p style="color:var(--text-secondary);margin-bottom:12px;">
                                Les catégories suivantes n'existent pas dans le système :
                            </p>
                            <ul style="list-style:none;padding:0;margin:8px 0 16px 0;">
                                ${categoriesList}
                            </ul>
                            <p style="color:var(--text-secondary);font-size:0.9rem;">
                                <i class="fas fa-info-circle" style="color:#64b4ff;"></i>
                                Souhaitez-vous les créer avant d'importer le fichier ?
                            </p>
                        </div>
                    `,
                    icon: 'question',
                    showCancelButton: true,
                    showDenyButton: true,
                    confirmButtonText: '<i class="fas fa-plus me-1"></i> Créer les catégories',
                    denyButtonText: '<i class="fas fa-forward me-1"></i> Ignorer et importer',
                    cancelButtonText: '<i class="fas fa-times me-1"></i> Annuler',
                    confirmButtonColor: '#00ffa3',
                    denyButtonColor: '#6c757d',
                    cancelButtonColor: '#dc3545',
                    background: getComputedStyle(document.documentElement).getPropertyValue('--card-bg-light').trim() || '#fff',
                    color: getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#1a2744',
                    customClass: {
                        popup: 'rounded-4',
                        confirmButton: 'btn fw-semibold px-4 py-2 rounded-pill',
                        denyButton: 'btn btn-secondary px-4 py-2 rounded-pill',
                        cancelButton: 'btn btn-danger px-4 py-2 rounded-pill'
                    }
                }).then(result => {
                    if (result.isConfirmed) {
                        // Créer les catégories
                        const categories = data.categoriesInconnues;

                        Swal.fire({
                            title: 'Création en cours...',
                            html: 'Veuillez patienter...',
                            allowOutsideClick: false,
                            didOpen: () => { Swal.showLoading(); }
                        });

                        Promise.all(categories.map(cat =>
                            fetch('{{ path("app_produit_import_create_category") }}', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ nom: cat })
                            })
                            .then(res => res.json())
                            .then(res => ({ success: res.success, nom: cat, message: res.message }))
                            .catch(() => ({ success: false, nom: cat, message: 'Erreur réseau' }))
                        )).then(results => {
                            const created = results.filter(r => r.success).length;
                            const failed = results.filter(r => !r.success).length;

                            if (failed === 0) {
                                Swal.fire({
                                    title: '✅ Catégories créées',
                                    html: `${created} catégorie(s) créée(s) avec succès.<br><br>Lancement de l'importation...`,
                                    icon: 'success',
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    // Relancer l'import avec skipCategories=1 pour ignorer les catégories déjà créées
                                    formData.append('skipCategories', '1');
                                    reimportFile(formData);
                                });
                            } else {
                                let message = `${created} catégorie(s) créée(s)`;
                                if (failed > 0) {
                                    message += `, ${failed} échec(s)`;
                                    const errors = results.filter(r => !r.success).map(r =>
                                        `<li style="color:#dc3545;">❌ ${r.nom} : ${r.message}</li>`
                                    ).join('');
                                    message += `<br><br><ul style="list-style:none;padding:0;">${errors}</ul>`;
                                }

                                Swal.fire({
                                    title: '⚠️ Création partielle',
                                    html: message + '<br><br>Souhaitez-vous quand même lancer l\'import ?',
                                    icon: 'warning',
                                    showCancelButton: true,
                                    confirmButtonText: 'Oui, importer',
                                    cancelButtonText: 'Annuler',
                                    confirmButtonColor: '#00ffa3',
                                    cancelButtonColor: '#dc3545'
                                }).then(result => {
                                    if (result.isConfirmed) {
                                        formData.append('skipCategories', '1');
                                        reimportFile(formData);
                                    } else {
                                        const modal = bootstrap.Modal.getInstance(document.getElementById('importModal'));
                                        if (modal) modal.hide();
                                        submitBtn.disabled = false;
                                        submitBtn.innerHTML = '<i class="fas fa-upload me-1"></i> Importer';
                                        submitBtn.style.opacity = '1';
                                    }
                                });
                            }
                        });

                    } else if (result.isDenied) {
                        // Ignorer les catégories manquantes
                        formData.append('skipCategories', '1');
                        reimportFile(formData);
                    } else {
                        // Annuler
                        const modal = bootstrap.Modal.getInstance(document.getElementById('importModal'));
                        if (modal) modal.hide();
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="fas fa-upload me-1"></i> Importer';
                        submitBtn.style.opacity = '1';
                    }
                });
                return;
            }

            // Gérer les erreurs
            if (data.action === 'erreur') {
                Swal.fire({
                    title: '❌ Erreur',
                    text: data.message || 'Une erreur est survenue lors de l\'importation.',
                    icon: 'error',
                    confirmButtonColor: '#dc3545',
                    background: getComputedStyle(document.documentElement).getPropertyValue('--card-bg-light').trim() || '#fff',
                    color: getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#1a2744'
                }).then(() => {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('importModal'));
                    if (modal) modal.hide();
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-upload me-1"></i> Importer';
                    submitBtn.style.opacity = '1';
                });
                return;
            }

            // Résultat de l'import (succes, partiel, echec, deja_existe)
            const isSuccess = data.action === 'succes' || data.action === 'deja_existe';
            const isPartial = data.action === 'partiel';
            const isEchec = data.action === 'echec';

            let icon = 'success';
            let confirmColor = '#00ffa3';
            let title = '✅ Importation terminée';

            if (isPartial) {
                icon = 'warning';
                confirmColor = '#f0a500';
                title = '⚠️ Importation partielle';
            } else if (isEchec) {
                icon = 'error';
                confirmColor = '#dc3545';
                title = '❌ Échec de l\'importation';
            } else if (data.action === 'deja_existe') {
                icon = 'info';
                confirmColor = '#64b4ff';
                title = 'ℹ️ Aucune modification';
            }

            // Construction du message détaillé
            let detailsHtml = '';
            if (data.compteurs) {
                const c = data.compteurs;
                const items = [];
                if (c.crees > 0) items.push(`<span style="color:#28a745;">${c.crees} créé(s)</span>`);
                if (c.mis_a_jour > 0) items.push(`<span style="color:#00cc82;">${c.mis_a_jour} mis à jour</span>`);
                if (c.deja_existe > 0) items.push(`<span style="color:#6c757d;">${c.deja_existe} déjà existant(s)</span>`);
                if (c.erreurs > 0) items.push(`<span style="color:#dc3545;">${c.erreurs} erreur(s)</span>`);

                if (items.length > 0) {
                    detailsHtml = `<div style="margin:12px 0;font-size:0.95rem;">${items.join(' · ')}</div>`;
                }
            }

            // Afficher les avertissements si présents
            let warningsHtml = '';
            if (data.avertissements && data.avertissements.length > 0) {
                const warnings = data.avertissements.slice(0, 5).map(w =>
                    `<li style="color:#ffc107;font-size:0.85rem;">⚠️ Ligne ${w.ligne} (SKU: ${w.sku}) : ${w.avertissement}</li>`
                ).join('');
                const more = data.avertissements.length > 5 ? `<li style="color:var(--text-secondary);font-size:0.85rem;">... et ${data.avertissements.length - 5} autre(s)</li>` : '';
                warningsHtml = `
                    <div style="margin-top:8px;">
                        <p style="color:var(--text-secondary);font-size:0.85rem;margin-bottom:4px;">
                            <i class="fas fa-info-circle" style="color:#ffc107;"></i> Avertissements :
                        </p>
                        <ul style="list-style:none;padding:0;margin:0;">${warnings}${more}</ul>
                    </div>
                `;
            }

            Swal.fire({
                title: title,
                html: `
                    <div style="text-align:left;">
                        <p style="color:var(--text-secondary);margin-bottom:8px;">${data.message}</p>
                        ${detailsHtml}
                        ${warningsHtml}
                        <p style="color:var(--text-secondary);font-size:0.85rem;margin-top:8px;">
                            <i class="fas fa-info-circle" style="color:#64b4ff;"></i>
                            L'historique a été enregistré.
                        </p>
                    </div>
                `,
                icon: icon,
                confirmButtonColor: confirmColor,
                confirmButtonText: '<i class="fas fa-check me-1"></i> OK',
                background: getComputedStyle(document.documentElement).getPropertyValue('--card-bg-light').trim() || '#fff',
                color: getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#1a2744',
                customClass: {
                    popup: 'rounded-4',
                    confirmButton: 'btn fw-semibold px-4 py-2 rounded-pill'
                }
            }).then(() => {
                const modal = bootstrap.Modal.getInstance(document.getElementById('importModal'));
                if (modal) modal.hide();
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-upload me-1"></i> Importer';
                submitBtn.style.opacity = '1';
                if (isSuccess) {
                    window.location.reload();
                }
            });

        })
        .catch(error => {
            Swal.fire({
                title: '❌ Erreur réseau',
                text: 'Impossible de communiquer avec le serveur.',
                icon: 'error',
                confirmButtonColor: '#dc3545',
                background: getComputedStyle(document.documentElement).getPropertyValue('--card-bg-light').trim() || '#fff',
                color: getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#1a2744'
            });
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-upload me-1"></i> Importer';
            submitBtn.style.opacity = '1';
        });
    });

    // Fonction pour relancer l'import après création des catégories
    function reimportFile(formData) {
        const submitBtn = document.getElementById('importSubmitBtn');
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Importation...';

        fetch('{{ path("app_produit_import") }}', {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.action === 'categories_manquantes') {
                // Si encore des catégories manquantes, on les ignore
                formData.append('skipCategories', '1');
                return reimportFile(formData);
            }

            if (data.action === 'erreur') {
                Swal.fire({
                    title: '❌ Erreur',
                    text: data.message || 'Une erreur est survenue.',
                    icon: 'error',
                    confirmButtonColor: '#dc3545'
                });
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-upload me-1"></i> Importer';
                submitBtn.style.opacity = '1';
                return;
            }

            // Afficher le résultat
            const isSuccess = data.action === 'succes' || data.action === 'deja_existe';
            const isPartial = data.action === 'partiel';
            const isEchec = data.action === 'echec';

            let icon = 'success';
            let confirmColor = '#00ffa3';
            let title = '✅ Importation terminée';

            if (isPartial) {
                icon = 'warning';
                confirmColor = '#f0a500';
                title = '⚠️ Importation partielle';
            } else if (isEchec) {
                icon = 'error';
                confirmColor = '#dc3545';
                title = '❌ Échec de l\'importation';
            } else if (data.action === 'deja_existe') {
                icon = 'info';
                confirmColor = '#64b4ff';
                title = 'ℹ️ Aucune modification';
            }

            let detailsHtml = '';
            if (data.compteurs) {
                const c = data.compteurs;
                const items = [];
                if (c.crees > 0) items.push(`<span style="color:#28a745;">${c.crees} créé(s)</span>`);
                if (c.mis_a_jour > 0) items.push(`<span style="color:#00cc82;">${c.mis_a_jour} mis à jour</span>`);
                if (c.deja_existe > 0) items.push(`<span style="color:#6c757d;">${c.deja_existe} déjà existant(s)</span>`);
                if (c.erreurs > 0) items.push(`<span style="color:#dc3545;">${c.erreurs} erreur(s)</span>`);

                if (items.length > 0) {
                    detailsHtml = `<div style="margin:12px 0;font-size:0.95rem;">${items.join(' · ')}</div>`;
                }
            }

            Swal.fire({
                title: title,
                html: `
                    <div style="text-align:left;">
                        <p style="color:var(--text-secondary);margin-bottom:8px;">${data.message}</p>
                        ${detailsHtml}
                        <p style="color:var(--text-secondary);font-size:0.85rem;margin-top:8px;">
                            <i class="fas fa-info-circle" style="color:#64b4ff;"></i>
                            L'historique a été enregistré.
                        </p>
                    </div>
                `,
                icon: icon,
                confirmButtonColor: confirmColor,
                confirmButtonText: '<i class="fas fa-check me-1"></i> OK',
                background: getComputedStyle(document.documentElement).getPropertyValue('--card-bg-light').trim() || '#fff',
                color: getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#1a2744'
            }).then(() => {
                const modal = bootstrap.Modal.getInstance(document.getElementById('importModal'));
                if (modal) modal.hide();
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-upload me-1"></i> Importer';
                submitBtn.style.opacity = '1';
                if (isSuccess) {
                    window.location.reload();
                }
            });
        })
        .catch(error => {
            Swal.fire({
                title: '❌ Erreur réseau',
                text: 'Impossible de communiquer avec le serveur.',
                icon: 'error',
                confirmButtonColor: '#dc3545'
            });
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-upload me-1"></i> Importer';
            submitBtn.style.opacity = '1';
        });
    }

    selectExportFormat('csv', 'CSV', '#00ffa3');
});
</script>
{% endblock %}
