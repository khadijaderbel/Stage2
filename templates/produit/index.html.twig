                        <p class="mb-1 fw-semibold" style="color:var(--text-primary);">Glissez votre fichier ici</p>
                        <p class="mb-0 small" style="color:var(--text-secondary);">ou cliquez pour parcourir</p>
                        <input type="file"
                               id="importFile"
                               name="importFile"
                               accept=".csv,.xlsx,.xls,.json"
                               class="d-none"
                               onchange="handleFileSelect(this)">
                    </div>
                    <div id="importFileName" class="mt-2 small text-center"
