{% extends 'base.html.twig' %}
{% block title %}NOVAWIN - {{ produit.nom }}{% endblock %}
{% block page_title %}Détail du Produit{% endblock %}
{% block page_subtitle %}{{ produit.sku }} — {{ produit.nom }}{% endblock %}

{% block body %}
<div class="container-fluid p-0">
    <div class="card border-0 shadow-sm rounded-4"
         style="background:var(--card-bg-light);border:1px solid var(--border-color);">
        <div class="card-body p-4">
            <div class="row g-4">
                <div class="col-md-3 text-center">
                    {% if produit.imageUrl %}
                        <img src="{{ produit.imageUrl }}" alt="{{ produit.nom }}"
                             style="max-width:100%;border-radius:16px;border:1px solid var(--border-color);">
                    {% else %}
                        <div style="width:100%;height:200px;border-radius:16px;background:var(--bg-body);
                                    border:1px solid var(--border-color);display:flex;align-items:center;justify-content:center;">
                            <i class="fas fa-image fa-3x" style="color:var(--text-secondary);opacity:0.4;"></i>
                        </div>
                    {% endif %}
                </div>
                <div class="col-md-9">
                    <table class="table" style="color:var(--text-primary);">
                        <tr><th style="color:var(--text-secondary);width:200px;">SKU</th>
                            <td><span style="color:var(--emerald);font-family:monospace;font-weight:600;">{{ produit.sku }}</span></td></tr>
                        <tr><th style="color:var(--text-secondary);">Nom</th><td>{{ produit.nom }}</td></tr>
                        <tr><th style="color:var(--text-secondary);">Catégorie</th><td>{{ produit.categorie.nom }}</td></tr>
                        <tr><th style="color:var(--text-secondary);">Statut</th>
                            <td>
                                {% if produit.statut == 'actif' %}
                                    <span class="badge" style="background:rgba(40,167,69,0.15);color:#28a745;">Actif</span>
                                {% elseif produit.statut == 'rupture' %}
                                    <span class="badge" style="background:rgba(220,53,69,0.15);color:#dc3545;">Rupture</span>
                                {% else %}
                                    <span class="badge" style="background:rgba(108,117,125,0.15);color:#6c757d;">Inactif</span>
                                {% endif %}
                            </td></tr>
                        <tr><th style="color:var(--text-secondary);">Créé par</th>
                            <td>{{ produit.utilisateur.prenom }} {{ produit.utilisateur.nom }}</td></tr>
                        <tr><th style="color:var(--text-secondary);">Date création</th>
                            <td>{{ produit.dateCreation|date('d/m/Y H:i') }}</td></tr>
                        {% if produit.dateModification %}
                        <tr><th style="color:var(--text-secondary);">Dernière modification</th>
                            <td>{{ produit.dateModification|date('d/m/Y H:i') }}</td></tr>
                        {% endif %}
                        {% if produit.caracteristiques %}
                        <tr><th style="color:var(--text-secondary);">Caractéristiques</th>
                            <td>{{ produit.caracteristiques }}</td></tr>
                        {% endif %}
                        {% if produit.descriptionOriginale %}
                        <tr><th style="color:var(--text-secondary);">Description originale</th>
                            <td>{{ produit.descriptionOriginale }}</td></tr>
                        {% endif %}
                        {% if produit.descriptionGeneree %}
                        <tr><th style="color:var(--text-secondary);">Description IA</th>
                            <td>{{ produit.descriptionGeneree }}</td></tr>
                        {% endif %}
                    </table>
                </div>
            </div>
            <div class="mt-4 d-flex gap-3">
                <a href="{{ path('app_produit_edit', {'id': produit.id}) }}" class="btn px-4 py-2 fw-semibold"
                   style="background:var(--emerald);color:#0b1329;border:none;border-radius:12px;">
                    <i class="fas fa-pen me-2"></i> Modifier
                </a>
                <a href="{{ path('app_produit_index') }}" class="btn px-4 py-2 fw-semibold"
                   style="background:transparent;color:var(--text-secondary);border:1.5px solid var(--border-color);border-radius:12px;">
                    <i class="fas fa-arrow-left me-2"></i> Retour
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
