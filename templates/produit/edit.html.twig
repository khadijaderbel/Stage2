{% extends 'base.html.twig' %}

{% block title %}NOVAWIN - Modifier le Produit{% endblock %}
{% block page_title %}Modifier le Produit{% endblock %}
{% block page_subtitle %}Modifiez les informations de {{ produit.nom }}{% endblock %}
{% block body %}
<div class="container-fluid p-0">

    {% for message in app.flashes('success') %}
        <div class="alert alert-success" style="border-radius:12px;border:none;background:rgba(40,167,69,0.12);color:#28a745;">
            <i class="fas fa-check-circle me-2"></i>{{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger" style="border-radius:12px;border:none;background:rgba(220,53,69,0.12);color:#dc3545;">
            <i class="fas fa-exclamation-circle me-2"></i>{{ message|raw }}
        </div>
    {% endfor %}

    <div class="card border-0 shadow-sm rounded-4"
         style="background:var(--card-bg-light);border:1px solid var(--border-color);">
        <div class="card-body p-4">

            {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'produitForm'}}) }}
            <div class="row g-4">

                <div class="col-md-6">
                    {{ form_label(form.sku, null, {'label_attr': {'class': 'form-label small fw-semibold', 'style': 'color:var(--text-secondary);'}}) }}
                    {{ form_widget(form.sku, {'attr': {'class': 'form-control', 'id': 'skuInput',
                        'style': 'background:var(--bg-body);border-color:var(--border-color);color:var(--text-primary);border-radius:10px;padding:0.6rem 1rem;'}}) }}
                    <small style="color:var(--text-secondary);"><i class="fas fa-info-circle me-1"></i>Format : NW-PROD-01 (majuscules, chiffres, tirets)</small>
                </div>

                <div class="col-md-6">
                    {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label small fw-semibold', 'style': 'color:var(--text-secondary);'}}) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'id': 'nomInput',
                        'style': 'background:var(--bg-body);border-color:var(--border-color);color:var(--text-primary);border-radius:10px;padding:0.6rem 1rem;'}}) }}
                </div>

                <div class="col-md-6">
                    {{ form_label(form.categorie, null, {'label_attr': {'class': 'form-label small fw-semibold', 'style': 'color:var(--text-secondary);'}}) }}
                    {{ form_widget(form.categorie, {'attr': {'class': 'form-select', 'id': 'categorieInput',
                        'style': 'background:var(--bg-body);border-color:var(--border-color);color:var(--text-primary);border-radius:10px;padding:0.6rem 1rem;'}}) }}
                </div>

                <div class="col-md-6">
                    {{ form_label(form.statut, null, {'label_attr': {'class': 'form-label small fw-semibold', 'style': 'color:var(--text-secondary);'}}) }}
                    {{ form_widget(form.statut, {'attr': {'class': 'form-select', 'id': 'statutInput',
                        'style': 'background:var(--bg-body);border-color:var(--border-color);color:var(--text-primary);border-radius:10px;padding:0.6rem 1rem;'}}) }}
                </div>

                <div class="col-12">
                    {{ form_label(form.imageUrl, null, {'label_attr': {'class': 'form-label small fw-semibold', 'style': 'color:var(--text-secondary);'}}) }}
                    {{ form_widget(form.imageUrl, {'attr': {'class': 'form-control', 'id': 'imageUrlInput',
                        'style': 'background:var(--bg-body);border-color:var(--border-color);color:var(--text-primary);border-radius:10px;padding:0.6rem 1rem;'}}) }}
                </div>

                <div class="col-12">
                    {{ form_label(form.caracteristiques, null, {'label_attr': {'class': 'form-label small fw-semibold', 'style': 'color:var(--text-secondary);'}}) }}
                    {{ form_widget(form.caracteristiques, {'attr': {'class': 'form-control',
                        'style': 'background:var(--bg-body);border-color:var(--border-color);color:var(--text-primary);border-radius:10px;padding:0.6rem 1rem;'}}) }}
                </div>

                <div class="col-md-6">
                    {{ form_label(form.descriptionOriginale, null, {'label_attr': {'class': 'form-label small fw-semibold', 'style': 'color:var(--text-secondary);'}}) }}
                    {{ form_widget(form.descriptionOriginale, {'attr': {'class': 'form-control',
                        'style': 'background:var(--bg-body);border-color:var(--border-color);color:var(--text-primary);border-radius:10px;padding:0.6rem 1rem;'}}) }}
                </div>

                <div class="col-md-6">
                    {{ form_label(form.descriptionGeneree, null, {'label_attr': {'class': 'form-label small fw-semibold', 'style': 'color:var(--text-secondary);'}}) }}
                    {{ form_widget(form.descriptionGeneree, {'attr': {'class': 'form-control',
                        'style': 'background:var(--bg-body);border-color:var(--border-color);color:var(--text-primary);border-radius:10px;padding:0.6rem 1rem;'}}) }}
                </div>

            </div>

            <div class="mt-4 d-flex gap-3">
                <button type="submit" class="btn px-4 py-2 fw-semibold"
                        style="background:var(--emerald);color:#0b1329;border:none;border-radius:12px;">
<i class="fas fa-save me-2"></i> Enregistrer les modifications
                </button>
                <a href="{{ path('app_produit_index') }}" class="btn px-4 py-2 fw-semibold"
                   style="background:transparent;color:var(--text-secondary);border:1.5px solid var(--border-color);border-radius:12px;">
                    <i class="fas fa-times me-2"></i> Annuler
                </a>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const form      = document.getElementById('produitForm');
    const skuInput  = document.getElementById('skuInput')  || document.querySelector('input[name$="[sku]"]');
    const nomInput  = document.getElementById('nomInput')  || document.querySelector('input[name$="[nom]"]');
    const catInput  = document.getElementById('categorieInput') || document.querySelector('select[name$="[categorie]"]');

    function buildErrorList(errors) {
        return errors.map(e => `<div style="padding:4px 0;display:flex;align-items:center;gap:8px;">
            <i class="fas fa-times-circle" style="color:#dc3545;font-size:14px;"></i>
            <span>${e.trim()}</span></div>`).join('');
    }

    function swalError(title, list) {
        return Swal.fire({
            title, icon: 'error',
            html: `<div style="text-align:left;padding:10px 0;">
                <p style="color:#6c757d;margin-bottom:12px;">Veuillez corriger les erreurs suivantes :</p>
                <div style="background:#f8f9fa;border-radius:8px;padding:12px 16px;border-left:4px solid #dc3545;">${list}</div>
            </div>`,
            confirmButtonColor: '#dc3545', confirmButtonText: '🔧 Corriger',
            background: getComputedStyle(document.documentElement).getPropertyValue('--card-bg-light').trim() || '#fff',
            color: getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#1a2744',
            customClass: { popup: 'rounded-4', confirmButton: 'btn btn-danger px-4 py-2 rounded-pill' }
        });
    }

    // Flash erreurs serveur
    document.querySelectorAll('.alert-danger').forEach(alert => {
        const raw = alert.innerText.trim(); alert.style.display = 'none';
        if (!raw) return;
        const errors = raw.split('|').map(e => e.trim()).filter(e => e);
        swalError('⚠️ Erreur de validation', buildErrorList(errors))
            .then(() => { if (skuInput) { skuInput.focus(); skuInput.select(); } });
    });
    document.querySelectorAll('.alert-success').forEach(alert => {
        const msg = alert.innerText.trim(); alert.style.display = 'none';
        if (!msg) return;
        Swal.fire({ title: '✅ Succès', text: msg, icon: 'success',
            confirmButtonColor: '#28a745', timer: 3000, timerProgressBar: true,
            background: getComputedStyle(document.documentElement).getPropertyValue('--card-bg-light').trim() || '#fff',
            customClass: { popup: 'rounded-4' } });
    });

    function validateForm() {
        const errors = [];
        const sku = skuInput ? skuInput.value.trim() : '';
        const nom = nomInput ? nomInput.value.trim() : '';
        const cat = catInput ? catInput.value : '';

        if (!sku) errors.push('Le SKU est obligatoire.');
        else if (!/^[A-Z0-9\-]+$/.test(sku)) errors.push('Le SKU ne doit contenir que des majuscules, chiffres et tirets.');

        if (!nom) errors.push('Le nom du produit est obligatoire.');
        else if (nom.length < 2) errors.push('Le nom doit contenir au moins 2 caractères.');

        if (!cat) errors.push('Veuillez sélectionner une catégorie.');

        return errors;
    }

    if (form) {
        form.addEventListener('submit', function (e) {
            const errors = validateForm();
            if (errors.length === 0) return;
            e.preventDefault();
            swalError('⚠️ Validation du formulaire', buildErrorList(errors))
                .then(() => { if (skuInput) { skuInput.focus(); skuInput.select(); } });
        });
    }

    // Feedback visuel
    function styleInput(input, valid) {
        if (!input) return;
        input.style.borderColor = valid ? '#28a745' : '#dc3545';
        input.style.boxShadow   = valid
            ? '0 0 0 0.2rem rgba(40,167,69,0.15)'
            : '0 0 0 0.2rem rgba(220,53,69,0.15)';
    }

    [skuInput, nomInput].forEach(input => {
        if (!input) return;
        input.addEventListener('input', function () {
            if (this.value.trim().length >= 2) styleInput(this, true);
            else if (this.value.trim()) styleInput(this, false);
            else { this.style.borderColor = 'var(--border-color)'; this.style.boxShadow = 'none'; }
        });
        input.addEventListener('focus', function () {
            this.style.borderColor = 'var(--emerald)';
            this.style.boxShadow = '0 0 0 0.2rem rgba(0,255,163,0.15)';
        });
        input.addEventListener('blur', function () {
            if (this.value.trim().length >= 2) styleInput(this, true);
            else if (this.value.trim()) styleInput(this, false);
            else { this.style.borderColor = 'var(--border-color)'; this.style.boxShadow = 'none'; }
        });
    });
});
</script>

<style>
    .form-control:focus, .form-select:focus {
        border-color: var(--emerald) !important;
        box-shadow: 0 0 0 0.2rem rgba(0,255,163,0.15) !important;
    }
    .swal2-popup { border-radius:16px !important; border:1px solid var(--border-color) !important; background:var(--card-bg-light) !important; }
    .swal2-title { color:var(--text-primary) !important; }
    .swal2-html-container { color:var(--text-secondary) !important; }
    .swal2-confirm { border:none !important; border-radius:50px !important; font-weight:600 !important; padding:0.6rem 1.5rem !important; }
    .alert { display:none !important; }
</style>
{% endblock %}
