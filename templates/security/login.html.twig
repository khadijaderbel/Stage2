<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NOVAWIN - Authentification</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --emerald: #00ffa3;
            --emerald-dark: #00cc82;
            --accent-color: #4a90d9;
            --primary-dark: #0b1329;
            --primary-light: #1a2744;
            --card-radius: 24px;
            --transition-speed: 0.8s;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #0b1329 0%, #1a2744 50%, #2c3e7a 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
            padding: 20px;
            overflow: hidden;
            position: relative;
        }

        /* Animated background particles */
        .bg-particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }

        .bg-particles span {
            position: absolute;
            display: block;
            width: 4px;
            height: 4px;
            background: rgba(0, 255, 163, 0.15);
            border-radius: 50%;
            animation: float 20s infinite linear;
        }

        .bg-particles span:nth-child(1) { top: 10%; left: 10%; animation-delay: 0s; }
        .bg-particles span:nth-child(2) { top: 20%; left: 80%; animation-delay: 2s; width: 6px; height: 6px; }
        .bg-particles span:nth-child(3) { top: 60%; left: 5%; animation-delay: 4s; }
        .bg-particles span:nth-child(4) { top: 70%; left: 90%; animation-delay: 6s; width: 8px; height: 8px; }
        .bg-particles span:nth-child(5) { top: 40%; left: 50%; animation-delay: 8s; }
        .bg-particles span:nth-child(6) { top: 85%; left: 30%; animation-delay: 3s; }
        .bg-particles span:nth-child(7) { top: 15%; left: 60%; animation-delay: 7s; width: 5px; height: 5px; }
        .bg-particles span:nth-child(8) { top: 50%; left: 20%; animation-delay: 5s; }

        @keyframes float {
            0% { transform: translateY(0) rotate(0deg); opacity: 0.3; }
            50% { opacity: 1; }
            100% { transform: translateY(-100vh) rotate(720deg); opacity: 0; }
        }

        .auth-container {
            width: 100%;
            max-width: 480px;
            position: relative;
            z-index: 1;
            perspective: 1500px;
        }

        /* Flip Card */
        .flip-card {
            background: transparent;
            width: 100%;
            height: 620px;
            perspective: 1500px;
        }

        .flip-card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            transition: transform var(--transition-speed) cubic-bezier(0.4, 0, 0.2, 1);
            transform-style: preserve-3d;
        }

        .flip-card.flipped .flip-card-inner {
            transform: rotateY(180deg);
        }

        .flip-card-front,
        .flip-card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            border-radius: var(--card-radius);
            padding: 2.5rem 2.5rem 2rem;
            background: rgba(255, 255, 255, 0.98);
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.1);
            overflow-y: auto;
        }

        .flip-card-front {
            transform: rotateY(0deg);
        }

        .flip-card-back {
            transform: rotateY(180deg);
        }

        /* Scrollbar for flip cards */
        .flip-card-front::-webkit-scrollbar,
        .flip-card-back::-webkit-scrollbar {
            width: 4px;
        }
        .flip-card-front::-webkit-scrollbar-thumb,
        .flip-card-back::-webkit-scrollbar-thumb {
            background: var(--emerald);
            border-radius: 10px;
        }

        /* Logo */
        .auth-logo {
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .auth-logo .logo-wrapper {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 72px;
            height: 72px;
            background: linear-gradient(135deg, var(--primary-dark), var(--primary-light));
            border-radius: 18px;
            margin-bottom: 0.75rem;
            box-shadow: 0 8px 30px rgba(0, 255, 163, 0.15);
            position: relative;
            transition: transform 0.3s ease;
        }

        .auth-logo .logo-wrapper:hover {
            transform: scale(1.05);
        }

        .auth-logo .logo-wrapper img {
            width: 48px;
            height: 48px;
            object-fit: contain;
        }

        .auth-logo .logo-wrapper .logo-glow {
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(0, 255, 163, 0.1) 0%, transparent 70%);
            animation: pulse-glow 3s ease-in-out infinite;
        }

        @keyframes pulse-glow {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.2); opacity: 1; }
        }

        .auth-logo h1 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 1.6rem;
            color: var(--primary-dark);
            margin: 0;
            letter-spacing: 1px;
        }

        .auth-logo h1 span {
            color: var(--emerald);
        }

        .auth-logo p {
            color: #6c757d;
            font-size: 0.85rem;
            margin: 0.2rem 0 0;
        }

        /* Alerts */
        .alert {
            border-radius: 12px;
            border: none;
            padding: 0.65rem 1rem;
            font-size: 0.85rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .alert-success {
            background: rgba(40, 167, 69, 0.12);
            color: #28a745;
        }

        .alert-danger {
            background: rgba(220, 53, 69, 0.12);
            color: #dc3545;
        }

        .alert .btn-close {
            filter: invert(1);
            font-size: 0.7rem;
            margin-left: auto;
        }

        /* Form */
        .form-group {
            margin-bottom: 1.1rem;
        }

        .form-group label {
            font-size: 0.7rem;
            font-weight: 600;
            color: #495057;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 0.3rem;
            display: block;
        }

        .form-group .input-group {
            border-radius: 12px;
            overflow: hidden;
            border: 2px solid #e9ecef;
            transition: all 0.3s ease;
            background: #fff;
        }

        .form-group .input-group:focus-within {
            border-color: var(--emerald);
            box-shadow: 0 0 0 4px rgba(0, 255, 163, 0.08);
        }

        .form-group .input-group.error {
            border-color: #dc3545;
            box-shadow: 0 0 0 4px rgba(220, 53, 69, 0.08);
        }

        .form-group .input-group-text {
            background: transparent;
            border: none;
            color: #6c757d;
            padding: 0.5rem 0.8rem 0.5rem 1rem;
            font-size: 0.85rem;
        }

        .form-group .form-control {
            border: none;
            padding: 0.5rem 1rem 0.5rem 0;
            background: transparent;
            font-size: 0.9rem;
            color: #1a2744;
        }

        .form-group .form-control:focus {
            box-shadow: none;
        }

        .form-group .form-control::placeholder {
            color: #adb5bd;
            font-size: 0.8rem;
        }

        .form-group .error-message {
            font-size: 0.7rem;
            color: #dc3545;
            margin-top: 0.25rem;
            display: none;
        }

        .form-group .error-message.show {
            display: block;
        }

        .password-toggle {
            cursor: pointer;
            padding: 0.5rem 1rem 0.5rem 0;
            color: #6c757d;
            transition: color 0.3s ease;
            background: transparent;
            border: none;
            font-size: 0.85rem;
        }

        .password-toggle:hover {
            color: var(--emerald);
        }

        .form-check {
            margin: 1rem 0;
        }

        .form-check-input {
            border: 2px solid #ced4da;
            border-radius: 4px;
            cursor: pointer;
            width: 17px;
            height: 17px;
            margin-top: 0.1rem;
            flex-shrink: 0;
        }

        .form-check-input:checked {
            background-color: var(--emerald);
            border-color: var(--emerald);
        }

        .form-check-label {
            font-size: 0.8rem;
            color: #495057;
            cursor: pointer;
            padding-left: 0.25rem;
        }

        .form-check-label a {
            color: var(--emerald);
            text-decoration: none;
            font-weight: 600;
        }

        .form-check-label a:hover {
            text-decoration: underline;
        }

        /* Button */
        .btn-primary-custom {
            width: 100%;
            padding: 0.75rem;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--primary-dark), var(--primary-light));
            color: #fff;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(11, 19, 41, 0.25);
            position: relative;
            overflow: hidden;
        }

        .btn-primary-custom::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(0, 255, 163, 0.1) 0%, transparent 60%);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .btn-primary-custom:hover::after {
            opacity: 1;
        }

        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(11, 19, 41, 0.35);
        }

        .btn-primary-custom:active {
            transform: translateY(0);
        }

        .btn-primary-custom .btn-content {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
            z-index: 1;
        }

        .btn-primary-custom .btn-spinner {
            display: none;
            width: 20px;
            height: 20px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .btn-primary-custom.loading .btn-spinner {
            display: block;
        }

        .btn-primary-custom.loading .btn-text {
            display: none;
        }

        /* Footer links */
        .auth-footer {
            text-align: center;
            margin-top: 1.25rem;
            font-size: 0.85rem;
            color: #6c757d;
        }

        .auth-footer a {
            color: var(--emerald);
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .auth-footer a:hover {
            color: var(--emerald-dark);
            text-decoration: underline;
        }

        .auth-bottom {
            text-align: center;
            margin-top: 1.5rem;
            color: rgba(255, 255, 255, 0.4);
            font-size: 0.7rem;
        }

        .auth-bottom strong {
            color: rgba(255, 255, 255, 0.7);
        }

        .security-badge {
            text-align: center;
            margin-top: 0.75rem;
            font-size: 0.65rem;
            color: #6c757d;
        }

        .security-badge i {
            color: #28a745;
            margin-right: 0.3rem;
        }

        /* Flip toggle icon */
        .flip-toggle-icon {
            display: inline-block;
            margin: 0 6px;
            font-size: 0.7rem;
            color: var(--emerald);
        }

        /* Responsive */
        @media (max-width: 576px) {
            .flip-card {
                height: 640px;
            }
            .flip-card-front,
            .flip-card-back {
                padding: 1.75rem 1.5rem;
            }
            .auth-logo h1 {
                font-size: 1.3rem;
            }
            .auth-logo .logo-wrapper {
                width: 60px;
                height: 60px;
            }
            .auth-logo .logo-wrapper img {
                width: 38px;
                height: 38px;
            }
            .form-group .form-control {
                font-size: 0.85rem;
            }
        }

        @media (max-width: 400px) {
            .flip-card {
                height: 680px;
            }
        }
    </style>
</head>
<body>
    <!-- Background Particles -->
    <div class="bg-particles">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
    </div>

    <div class="auth-container">
        <div class="flip-card" id="flipCard">
            <div class="flip-card-inner">
                <!-- ============================================
                     FACE AVANT - LOGIN
                     ============================================ -->
                <div class="flip-card-front">
                    <div class="auth-logo">
                        <div class="logo-wrapper">
                            <div class="logo-glow"></div>
                            <img src="{{ asset('images/logo1.png') }}" alt="NOVAWIN" onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=\'fas fa-cube\' style=\'font-size:2rem;color:#00ffa3;\'></i>'">
                        </div>
                        <h1>NOVA<span>WIN</span></h1>
                        <p>Console de Contrôle Administrative</p>
                    </div>

                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle"></i> {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {% if error %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle"></i> {{ error.messageKey|trans(error.messageData, 'security') }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endif %}

                    <div class="text-center mb-3">
                        <h5 class="fw-bold" style="color: var(--primary-dark); font-size: 1.1rem;">
                            <i class="fas fa-sign-in-alt me-2" style="color: var(--emerald);"></i>Se connecter
                        </h5>
                    </div>

                    <form id="loginForm" method="POST" action="{{ path('app_login') }}" novalidate>
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <div class="form-group">
                            <label for="login_email"><i class="fas fa-envelope me-1"></i> Adresse email</label>
                            <div class="input-group" id="loginEmailGroup">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input type="email" class="form-control" id="login_email" name="_username"
                                       placeholder="nom@novawin.com" value="{{ last_username }}" autofocus>
                            </div>
                            <div class="error-message" id="loginEmailError">Veuillez saisir une adresse email valide.</div>
                        </div>

                        <div class="form-group">
                            <label for="login_password"><i class="fas fa-lock me-1"></i> Mot de passe</label>
                            <div class="input-group" id="loginPasswordGroup">
                                <span class="input-group-text"><i class="fas fa-key"></i></span>
                                <input type="password" class="form-control" id="login_password" name="_password"
                                       placeholder="••••••••">
                                <button type="button" class="password-toggle" onclick="togglePassword('login_password', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="error-message" id="loginPasswordError">Le mot de passe est obligatoire.</div>
                        </div>

                        <div class="form-check d-flex align-items-center gap-2">
                            <input type="checkbox" class="form-check-input" id="remember_me" name="_remember_me" value="on">
                            <label class="form-check-label" for="remember_me">Se souvenir de moi</label>
                        </div>

                        <button type="submit" class="btn-primary-custom" id="loginBtn">
                            <span class="btn-content">
                                <span class="btn-spinner"></span>
                                <span class="btn-text"><i class="fas fa-sign-in-alt me-2"></i>Se connecter</span>
                            </span>
                        </button>

                        <div class="security-badge">
                            <i class="fas fa-shield-alt"></i> Réseau interne d'administration sécurisé
                        </div>
                    </form>

                    <div class="auth-footer">
                        Pas encore de compte ?
                        <a onclick="flipCard()">
                            Créer un compte <i class="fas fa-arrow-right flip-toggle-icon"></i>
                        </a>
                    </div>
                </div>

         
                <div class="flip-card-back">
                    <div class="auth-logo">
                        <div class="logo-wrapper">
                            <div class="logo-glow"></div>
                            <img src="{{ asset('images/logo1.png') }}" alt="NOVAWIN" onerror="this.style.display='none'; this.parentElement.innerHTML='<i class=\'fas fa-cube\' style=\'font-size:2rem;color:#00ffa3;\'></i>'">
                        </div>
                        <h1>NOVA<span>WIN</span></h1>
                        <p>Rejoindre l'équipe</p>
                    </div>

                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle"></i> {{ message|raw }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    <div class="text-center mb-3">
                        <h5 class="fw-bold" style="color: var(--primary-dark); font-size: 1.1rem;">
                            <i class="fas fa-user-plus me-2" style="color: var(--emerald);"></i>Créer un compte
                        </h5>
                        <p class="text-muted small" style="font-size: 0.8rem;">Enregistrez un nouveau compte modérateur.</p>
                    </div>

                    <form id="signupForm" method="POST" action="{{ path('app_signup') }}" novalidate>
                        <input type="hidden" name="_token" value="{{ csrf_token('signup') }}">

                        <div class="row g-2">
                            <div class="col-6">
                                <div class="form-group">
                                    <label for="signup_prenom"><i class="fas fa-user me-1"></i> Prénom</label>
                                    <div class="input-group" id="signupPrenomGroup">
                                        <span class="input-group-text"><i class="fas fa-user-circle"></i></span>
                                        <input type="text" class="form-control" id="signup_prenom" name="prenom"
                                               placeholder="Alexandre" value="{{ app.request.get('prenom') }}">
                                    </div>
                                    <div class="error-message" id="signupPrenomError">Le prénom est obligatoire (minimum 2 caractères).</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group">
                                    <label for="signup_nom"><i class="fas fa-user me-1"></i> Nom</label>
                                    <div class="input-group" id="signupNomGroup">
                                        <span class="input-group-text"><i class="fas fa-user-circle"></i></span>
                                        <input type="text" class="form-control" id="signup_nom" name="nom"
                                               placeholder="Vincent" value="{{ app.request.get('nom') }}">
                                    </div>
                                    <div class="error-message" id="signupNomError">Le nom est obligatoire (minimum 2 caractères).</div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="signup_email"><i class="fas fa-envelope me-1"></i> Adresse email</label>
                            <div class="input-group" id="signupEmailGroup">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                <input type="email" class="form-control" id="signup_email" name="email"
                                       placeholder="nom@novawin.com" value="{{ app.request.get('email') }}">
                            </div>
                            <div class="error-message" id="signupEmailError">Veuillez saisir une adresse email valide.</div>
                        </div>

                        <div class="form-group">
                            <label for="signup_password"><i class="fas fa-lock me-1"></i> Mot de passe</label>
                            <div class="input-group" id="signupPasswordGroup">
                                <span class="input-group-text"><i class="fas fa-key"></i></span>
                                <input type="password" class="form-control" id="signup_password" name="password"
                                       placeholder="••••••••">
                                <button type="button" class="password-toggle" onclick="togglePassword('signup_password', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="error-message" id="signupPasswordError">Le mot de passe doit contenir au moins 6 caractères.</div>
                        </div>

                        <div class="form-group">
                            <label for="signup_password_confirm"><i class="fas fa-check-circle me-1"></i> Confirmer</label>
                            <div class="input-group" id="signupPasswordConfirmGroup">
                                <span class="input-group-text"><i class="fas fa-check"></i></span>
                                <input type="password" class="form-control" id="signup_password_confirm" name="password_confirm"
                                       placeholder="••••••••">
                                <button type="button" class="password-toggle" onclick="togglePassword('signup_password_confirm', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <div class="error-message" id="signupPasswordConfirmError">Les mots de passe ne correspondent pas.</div>
                        </div>

                        <div class="form-check d-flex align-items-start gap-2">
                            <input type="checkbox" class="form-check-input" id="accept_terms" name="accept_terms" value="1">
                            <label class="form-check-label" for="accept_terms">
                                J'accepte la <a href="#" onclick="event.preventDefault()">charte d'utilisation</a>
                            </label>
                        </div>
                        <div class="error-message" id="signupTermsError" style="font-size: 0.7rem; color: #dc3545; margin-top: -0.5rem; display: none;">
                            Vous devez accepter la charte d'utilisation.
                        </div>

                        <button type="submit" class="btn-primary-custom mt-2" id="signupBtn">
                            <span class="btn-content">
                                <span class="btn-spinner"></span>
                                <span class="btn-text"><i class="fas fa-user-plus me-2"></i>Créer le compte</span>
                            </span>
                        </button>

                        <div class="security-badge">
                            <i class="fas fa-shield-alt"></i> Réseau interne d'administration sécurisé
                        </div>
                    </form>

                    <div class="auth-footer">
                        Déjà un compte ?
                        <a onclick="flipCard()">
                            <i class="fas fa-arrow-left flip-toggle-icon"></i> Se connecter
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-bottom">
            © 2026. <strong>NOVAWIN</strong> — Console de Contrôle Administrative. Tous droits réservés.
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ============================================
        // FLIP CARD
        // ============================================
        function flipCard() {
            document.getElementById('flipCard').classList.toggle('flipped');
        }

        // Flip si paramètre register=true dans l'URL
        document.addEventListener('DOMContentLoaded', function() {
            const params = new URLSearchParams(window.location.search);
            if (params.get('register') === 'true') {
                document.getElementById('flipCard').classList.add('flipped');
            }
        });

        // ============================================
        // PASSWORD TOGGLE
        // ============================================
        function togglePassword(inputId, button) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('i');

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        // ============================================
        // VALIDATION LOGIN (non HTML5)
        // ============================================
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const email = document.getElementById('login_email');
            const password = document.getElementById('login_password');
            const emailGroup = document.getElementById('loginEmailGroup');
            const passwordGroup = document.getElementById('loginPasswordGroup');
            const emailError = document.getElementById('loginEmailError');
            const passwordError = document.getElementById('loginPasswordError');

            let isValid = true;

            // Reset errors
            emailGroup.classList.remove('error');
            passwordGroup.classList.remove('error');
            emailError.classList.remove('show');
            passwordError.classList.remove('show');

            // Validate email
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!email.value.trim() || !emailRegex.test(email.value.trim())) {
                emailGroup.classList.add('error');
                emailError.classList.add('show');
                isValid = false;
            }

            // Validate password
            if (!password.value.trim()) {
                passwordGroup.classList.add('error');
                passwordError.classList.add('show');
                isValid = false;
            }

            if (isValid) {
                // Show loading state
                const btn = document.getElementById('loginBtn');
                btn.classList.add('loading');

                // Submit the form
                setTimeout(() => {
                    this.submit();
                }, 300);
            }
        });

        // ============================================
        // VALIDATION SIGNUP (non HTML5)
        // ============================================
        document.getElementById('signupForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const prenom = document.getElementById('signup_prenom');
            const nom = document.getElementById('signup_nom');
            const email = document.getElementById('signup_email');
            const password = document.getElementById('signup_password');
            const passwordConfirm = document.getElementById('signup_password_confirm');
            const acceptTerms = document.getElementById('accept_terms');

            const prenomGroup = document.getElementById('signupPrenomGroup');
            const nomGroup = document.getElementById('signupNomGroup');
            const emailGroup = document.getElementById('signupEmailGroup');
            const passwordGroup = document.getElementById('signupPasswordGroup');
            const passwordConfirmGroup = document.getElementById('signupPasswordConfirmGroup');

            const prenomError = document.getElementById('signupPrenomError');
            const nomError = document.getElementById('signupNomError');
            const emailError = document.getElementById('signupEmailError');
            const passwordError = document.getElementById('signupPasswordError');
            const passwordConfirmError = document.getElementById('signupPasswordConfirmError');
            const termsError = document.getElementById('signupTermsError');

            let isValid = true;

            // Reset errors
            [prenomGroup, nomGroup, emailGroup, passwordGroup, passwordConfirmGroup].forEach(el => {
                el.classList.remove('error');
            });
            [prenomError, nomError, emailError, passwordError, passwordConfirmError].forEach(el => {
                el.classList.remove('show');
            });
            termsError.style.display = 'none';

            // Validate prenom
            if (!prenom.value.trim() || prenom.value.trim().length < 2) {
                prenomGroup.classList.add('error');
                prenomError.classList.add('show');
                isValid = false;
            }

            // Validate nom
            if (!nom.value.trim() || nom.value.trim().length < 2) {
                nomGroup.classList.add('error');
                nomError.classList.add('show');
                isValid = false;
            }

            // Validate email
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!email.value.trim() || !emailRegex.test(email.value.trim())) {
                emailGroup.classList.add('error');
                emailError.classList.add('show');
                isValid = false;
            }

            // Validate password
            if (!password.value.trim() || password.value.trim().length < 6) {
                passwordGroup.classList.add('error');
                passwordError.classList.add('show');
                isValid = false;
            }

            // Validate password confirmation
            if (password.value.trim() !== passwordConfirm.value.trim()) {
                passwordConfirmGroup.classList.add('error');
                passwordConfirmError.classList.add('show');
                isValid = false;
            }

            // Validate terms
            if (!acceptTerms.checked) {
                termsError.style.display = 'block';
                isValid = false;
            }

            if (isValid) {
                // Show loading state
                const btn = document.getElementById('signupBtn');
                btn.classList.add('loading');

                // Submit the form
                setTimeout(() => {
                    this.submit();
                }, 300);
            }
        });

        // ============================================
        // REAL-TIME VALIDATION CLEANUP
        // ============================================
        // Login fields
        document.getElementById('login_email').addEventListener('input', function() {
            const group = document.getElementById('loginEmailGroup');
            const error = document.getElementById('loginEmailError');
            group.classList.remove('error');
            error.classList.remove('show');
        });

        document.getElementById('login_password').addEventListener('input', function() {
            const group = document.getElementById('loginPasswordGroup');
            const error = document.getElementById('loginPasswordError');
            group.classList.remove('error');
            error.classList.remove('show');
        });

        // Signup fields
        ['signup_prenom', 'signup_nom', 'signup_email', 'signup_password', 'signup_password_confirm'].forEach(id => {
            document.getElementById(id).addEventListener('input', function() {
                const groupId = id.replace('signup_', 'signup') + 'Group';
                const errorId = id.replace('signup_', 'signup') + 'Error';
                const group = document.getElementById(groupId);
                const error = document.getElementById(errorId);
                if (group) {
                    group.classList.remove('error');
                    error.classList.remove('show');
                }
            });
        });

        document.getElementById('accept_terms').addEventListener('change', function() {
            document.getElementById('signupTermsError').style.display = 'none';
        });

        // ============================================
        // KEYBOARD SHORTCUT: ESC to flip back
        // ============================================
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const card = document.getElementById('flipCard');
                if (card.classList.contains('flipped')) {
                    card.classList.remove('flipped');
                }
            }
        });
    </script>
</body>
</html>
