{% extends 'base.html.twig' %}
{% block title %}NOVAWIN — Journal d'import · {{ historique.nomFichier }}{% endblock %}
{% block page_title %}Journal d'import{% endblock %}
{% block page_subtitle %}Détail d'exécution de l'import.{% endblock %}

{% block body %}
<div class="container-fluid p-0">

    {# ── Fil d'Ariane #}
    <div class="d-flex align-items-center gap-2 mb-4"
         style="color:var(--text-secondary);font-size:0.85rem;">
        <a href="{{ path('app_historique_importation_index') }}"
           style="color:var(--text-secondary);text-decoration:none;">
            <i class="fas fa-history me-1"></i>Historique d'import
        </a>
        <i class="fas fa-chevron-right" style="font-size:0.6rem;opacity:0.5;"></i>
        <span style="color:var(--text-primary);">{{ historique.nomFichier }}</span>
    </div>

    {# ── En-tête du journal ───────────────────────────────────────── #}
    <div class="card border-0 rounded-4 mb-4"
         style="background:var(--card-bg-light);border:1px solid var(--border-color);">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">

                {# Infos fichier #}
                <div class="d-flex align-items-center gap-3">
                    {# Icône format #}
                    {% set fmtIcons  = {'json':'fa-file-code','csv':'fa-file-csv','xlsx':'fa-file-excel','xls':'fa-file-excel'} %}
                    {% set fmtColors = {'json':'#f0a500','csv':'#00ffa3','xlsx':'#1d6f42','xls':'#1d6f42'} %}
                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:52px;height:52px;
                                background:{{ fmtColors[historique.formatFichier] ?? '#6c757d' }}18;
                                flex-shrink:0;">
                        <i class="fas {{ fmtIcons[historique.formatFichier] ?? 'fa-file' }} fa-lg"
                           style="color:{{ fmtColors[historique.formatFichier] ?? '#6c757d' }};"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-1" style="color:var(--text-primary);">
                            {{ historique.nomFichier }}
                        </h5>
                        <div class="d-flex align-items-center gap-3 flex-wrap"
                             style="font-size:0.82rem;color:var(--text-secondary);">
                            <span>
                                <i class="fas fa-calendar-alt me-1"></i>
                                {{ historique.dateImportation|date('d/m/Y à H:i:s') }}
                            </span>
                            <span>
                                <i class="fas fa-user me-1"></i>
                                {{ historique.user.prenom }} {{ historique.user.nom }}
                            </span>
                            <span class="badge rounded-pill px-2 py-1"
                                  style="background:rgba(255,255,255,0.06);
                                         color:{{ fmtColors[historique.formatFichier] ?? '#6c757d' }};
                                         font-size:0.65rem;">
                                .{{ historique.formatFichier|upper }}
                            </span>
                        </div>
                    </div>
                </div>

                {# Statut principal #}
                <div class="text-end">
                    {% if historique.statut == 'succes' %}
                        <div class="fw-bold" style="color:#28a745;font-size:1.1rem;">
                            <i class="fas fa-check-circle me-1"></i>Réussi
                        </div>
                    {% elseif historique.statut == 'partiel' %}
                        <div class="fw-bold" style="color:#f0a500;font-size:1.1rem;">
                            <i class="fas fa-exclamation-circle me-1"></i>Partiel
                        </div>
                    {% elseif historique.statut == 'echec' %}
                        <div class="fw-bold" style="color:#dc3545;font-size:1.1rem;">
                            <i class="fas fa-times-circle me-1"></i>Échoué
                        </div>
                    {% else %}
                        <div class="fw-bold" style="color:#6c757d;font-size:1.1rem;">
                            <i class="fas fa-clock me-1"></i>En cours
                        </div>
                    {% endif %}
                    {% if historique.messageResume %}
                        <div class="small mt-1" style="color:var(--text-secondary);">
                            {{ historique.messageResume }}
                        </div>
                    {% endif %}
                </div>

            </div>

            {# ── Compteurs ──────────────────────────────────────────── #}
            <div class="row g-3 mt-2">

                <div class="col-6 col-md-3">
                    <div class="rounded-3 p-3 text-center"
                         style="background:var(--bg-body);border:1px solid var(--border-color);">
                        <div class="fw-bold fs-3" style="color:var(--text-primary);line-height:1;">
                            {{ historique.nombreLignes }}
                        </div>
                        <div class="small mt-1" style="color:var(--text-secondary);">
                            <i class="fas fa-list me-1"></i>Lignes lues
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="rounded-3 p-3 text-center"
                         style="background:rgba(40,167,69,0.06);border:1px solid rgba(40,167,69,0.2);">
                        <div class="fw-bold fs-3" style="color:#28a745;line-height:1;">
                            {{ historique.nombreImportes }}
                        </div>
                        <div class="small mt-1" style="color:var(--text-secondary);">
                            <i class="fas fa-check me-1"></i>Importés
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="rounded-3 p-3 text-center"
                         style="background:rgba(220,53,69,0.06);border:1px solid rgba(220,53,69,{{ historique.nombreErreurs > 0 ? '0.3' : '0.1' }});">
                        <div class="fw-bold fs-3"
                             style="color:{{ historique.nombreErreurs > 0 ? '#dc3545' : 'var(--text-secondary)' }};line-height:1;">
                            {{ historique.nombreErreurs }}
                        </div>
                        <div class="small mt-1" style="color:var(--text-secondary);">
                            <i class="fas fa-times me-1"></i>Erreurs
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="rounded-3 p-3 text-center"
                         style="background:var(--bg-body);border:1px solid var(--border-color);">
                        {% set taux = historique.nombreLignes > 0
                            ? ((historique.nombreImportes / historique.nombreLignes) * 100)|round
                            : 0 %}
                        <div class="fw-bold fs-3"
                             style="color:var(--emerald);line-height:1;">
                            {{ taux }}<span style="font-size:0.8rem;">%</span>
                        </div>
                        <div class="small mt-1" style="color:var(--text-secondary);">
                            <i class="fas fa-chart-pie me-1"></i>Taux réussite
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    {# ── Détail des erreurs ───────────────────────────────────────── #}
    {% set erreurs = historique.detailErreursArray %}

    {% if erreurs|length > 0 %}
        <div class="card border-0 rounded-4 mb-4"
             style="background:var(--card-bg-light);border:1px solid var(--border-color);">
            <div class="card-body p-0">
                <div class="px-4 py-3"
                     style="border-bottom:1px solid var(--border-color);">
                    <h6 class="fw-bold mb-0" style="color:#dc3545;">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Lignes ignorées ({{ erreurs|length }})
                    </h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0"
                           style="color:var(--text-primary);font-size:0.85rem;">
                        <thead style="background:var(--bg-body);">
                            <tr>
                                <th class="px-4 py-2" style="color:var(--text-secondary);width:80px;">Ligne</th>
                                <th class="px-4 py-2" style="color:var(--text-secondary);width:160px;">SKU</th>
                                <th class="px-4 py-2" style="color:var(--text-secondary);">Message d'erreur</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for err in erreurs %}
                                <tr style="border-color:var(--border-color);">
                                    <td class="px-4 py-2 text-center">
                                        <span class="badge rounded-pill"
                                              style="background:rgba(220,53,69,0.12);
                                                     color:#dc3545;font-size:0.7rem;">
                                            {{ err.ligne ?? '—' }}
                                        </span>
                                    </td>
                                    <td class="px-4 py-2">
                                        <code style="color:var(--emerald);font-size:0.8rem;">
                                            {{ err.sku ?? '—' }}
                                        </code>
                                    </td>
                                    <td class="px-4 py-2" style="color:#dc3545;">
                                        <i class="fas fa-exclamation-circle me-1" style="font-size:0.75rem;"></i>
                                        {{ err.erreur ?? '—' }}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% else %}
        <div class="card border-0 rounded-4 mb-4"
             style="background:rgba(40,167,69,0.05);border:1.5px solid rgba(40,167,69,0.2);">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <i class="fas fa-check-circle fa-lg" style="color:#28a745;"></i>
                <span style="color:#28a745;font-weight:600;">
                    Aucune erreur détectée — toutes les lignes ont été importées avec succès.
                </span>
            </div>
        </div>
    {% endif %}

    {# ── Actions ──────────────────────────────────────────────────── #}
    <div class="d-flex gap-2 flex-wrap">
        <a href="{{ path('app_historique_importation_index') }}"
           class="btn px-4"
           style="background:transparent;border:1.5px solid var(--border-color);
                  color:var(--text-secondary);border-radius:10px;font-size:0.88rem;">
            <i class="fas fa-arrow-left me-2"></i>Retour à l'historique
        </a>
        <a href="{{ path('app_produit_index') }}"
           class="btn px-4 fw-semibold"
           style="background:var(--emerald);color:#0b1329;
                  border:none;border-radius:10px;font-size:0.88rem;">
            <i class="fas fa-box me-2"></i>Voir les produits
        </a>
        <form action="{{ path('app_historique_importation_delete', {'id': historique.id}) }}"
              method="POST" class="d-inline" id="deleteForm">
            <input type="hidden" name="_token"
                   value="{{ csrf_token('delete_historique_' ~ historique.id) }}">
            <button type="button"
                    class="btn px-4"
                    onclick="confirmDelete()"
                    style="background:transparent;border:1.5px solid rgba(220,53,69,0.4);
                           color:#dc3545;border-radius:10px;font-size:0.88rem;">
                <i class="fas fa-trash me-2"></i>Supprimer cette entrée
            </button>
        </form>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
function confirmDelete() {
    Swal.fire({
        title: 'Supprimer cette entrée ?',
        html: `<p style="color:var(--text-secondary);">
            Cette entrée du journal sera supprimée définitivement.
            Les produits ne seront pas affectés.
        </p>`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc3545',
        cancelButtonColor:  '#6c757d',
        confirmButtonText:  '<i class="fas fa-trash me-1"></i> Supprimer',
        cancelButtonText:   'Annuler',
        background: getComputedStyle(document.documentElement)
            .getPropertyValue('--card-bg-light').trim() || '#fff',
        color: getComputedStyle(document.documentElement)
            .getPropertyValue('--text-primary').trim() || '#111',
        customClass: {
            popup:         'rounded-4',
            confirmButton: 'btn btn-danger px-4 py-2 rounded-pill',
            cancelButton:  'btn btn-secondary px-4 py-2 rounded-pill',
        }
    }).then(r => { if (r.isConfirmed) document.getElementById('deleteForm').submit(); });
}
</script>

<style>
    .table > :not(caption) > * > * { background-color: transparent !important; }
    .swal2-popup { border-radius:16px !important; border:1px solid var(--border-color) !important; }
    .swal2-confirm, .swal2-cancel {
        border:none !important; border-radius:50px !important;
        font-weight:600 !important; padding:0.6rem 1.5rem !important;
    }
    .swal2-cancel { background:#6c757d !important; }
    .swal2-actions { gap:0.75rem !important; }
</style>
{% endblock %}
