{% extends 'base.html.twig' %}
{% block title %}NOVAWIN — Gestion d'Historique d'Importation{% endblock %}
{% block page_title %}Gestion d'Historique d'Importation{% endblock %}
{% block page_subtitle %}Historique d'exécution des imports.{% endblock %}

{% block body %}
<div class="container-fluid p-0">

    {# ── Flash messages ───────────────────────────────────────────── #}
    {% for msg in app.flashes('success') %}
        <div class="alert mb-4"
             style="border-radius:12px;border:none;background:rgba(40,167,69,0.12);color:#28a745;">
            <i class="fas fa-check-circle me-2"></i>{{ msg }}
        </div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="alert mb-4"
             style="border-radius:12px;border:none;background:rgba(220,53,69,0.12);color:#dc3545;">
            <i class="fas fa-exclamation-circle me-2"></i>{{ msg }}
        </div>
    {% endfor %}

    {# ── En-tête ──────────────────────────────────────────────────── #}
    <div class="mb-4">
        <h2 class="mb-1 fw-bold" style="color:var(--text-primary);">
            Gestion des Importations
        </h2>
        <p class="mb-0" style="color:var(--text-secondary);">
            Historique d'exécution. Les catalogues peuvent être importés à tout moment
            via l'outil d'import de l'onglet
            <a href="{{ path('app_produit_index') }}"
               style="color:var(--emerald);text-decoration:none;">Produits</a>.
        </p>
    </div>

    {# ── Cartes statistiques ──────────────────────────────────────── #}
    <div class="row g-3 mb-4">

        <div class="col-6 col-md-3">
            <div class="card border-0 rounded-4 h-100"
                 style="background:var(--card-bg-light);border:1px solid var(--border-color);">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center"
                             style="width:42px;height:42px;background:rgba(0,255,163,0.1);">
                            <i class="fas fa-file-import" style="color:var(--emerald);font-size:1rem;"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-4" style="color:var(--text-primary);line-height:1;">
                                {{ stats.total }}
                            </div>
                            <div class="small" style="color:var(--text-secondary);">Total imports</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 rounded-4 h-100"
                 style="background:var(--card-bg-light);border:1px solid var(--border-color);">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center"
                             style="width:42px;height:42px;background:rgba(40,167,69,0.12);">
                            <i class="fas fa-check-circle" style="color:#28a745;font-size:1rem;"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-4" style="color:#28a745;line-height:1;">
                                {{ stats.succes }}
                            </div>
                            <div class="small" style="color:var(--text-secondary);">Réussis</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 rounded-4 h-100"
                 style="background:var(--card-bg-light);border:1px solid var(--border-color);">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center"
                             style="width:42px;height:42px;background:rgba(212,160,23,0.15);">
                            <i class="fas fa-exclamation-triangle" style="color:#d4a017;font-size:1rem;"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-4" style="color:#d4a017;line-height:1;">
                                {{ stats.succes_warnings }}
                            </div>
                            <div class="small" style="color:var(--text-secondary);">Avec avertissements</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 rounded-4 h-100"
                 style="background:var(--card-bg-light);border:1px solid var(--border-color);">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center"
                             style="width:42px;height:42px;background:rgba(220,53,69,0.12);">
                            <i class="fas fa-times-circle" style="color:#dc3545;font-size:1rem;"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-4" style="color:#dc3545;line-height:1;">
                                {{ stats.echec + stats.partiel }}
                            </div>
                            <div class="small" style="color:var(--text-secondary);">Avec erreurs</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    {# ── Tableau journal ──────────────────────────────────────────── #}
    <div class="card border-0 rounded-4"
         style="background:var(--card-bg-light);border:1px solid var(--border-color);">
        <div class="card-body p-0">

            {# En-tête du tableau #}
            <div class="d-flex align-items-center justify-content-between px-4 py-3"
                 style="border-bottom:1px solid var(--border-color);">
                <h6 class="fw-bold mb-0" style="color:var(--text-primary);">
                    Journal de traitement des imports
                </h6>
                {% if historiques|length > 0 %}
                    <button type="button"
                            class="btn btn-sm"
                            onclick="confirmClear()"
                            style="background:transparent;border:none;
                                   color:#dc3545;font-size:0.85rem;font-weight:600;
                                   text-decoration:underline;padding:0;">
                        Vider l'historique
                    </button>
                {% endif %}
            </div>

            {# Tableau #}
            {% if historiques is empty %}
                <div class="text-center py-5" style="color:var(--text-secondary);">
                    <i class="fas fa-history fa-3x d-block mb-3" style="opacity:0.3;"></i>
                    <p class="mb-1 fw-semibold" style="color:var(--text-primary);">
                        Aucun import effectué
                    </p>
                    <p class="mb-3 small">
                        Les imports apparaîtront ici dès que vous utiliserez
                        l'outil d'import dans la gestion des produits.
                    </p>
                    <a href="{{ path('app_produit_index') }}"
                       class="btn btn-sm px-4 fw-semibold"
                       style="background:var(--emerald);color:#0b1329;
                              border:none;border-radius:10px;">
                        <i class="fas fa-arrow-left me-2"></i>Aller aux produits
                    </a>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0"
                           style="color:var(--text-primary);">
                        <thead style="background:var(--bg-body);">
                            <tr>
                                <th class="px-4 py-3 text-uppercase small fw-bold"
                                    style="font-size:0.65rem;letter-spacing:1px;
                                           color:var(--text-secondary);width:160px;">
                                    DATE / HEURE
                                </th>
                                <th class="px-4 py-3 text-uppercase small fw-bold"
                                    style="font-size:0.65rem;letter-spacing:1px;color:var(--text-secondary);">
                                    NOM DU FICHIER
                                </th>
                                <th class="px-4 py-3 text-uppercase small fw-bold"
                                    style="font-size:0.65rem;letter-spacing:1px;color:var(--text-secondary);">
                                    RÉSULTATS
                                </th>
                                <th class="px-4 py-3 text-uppercase small fw-bold"
                                    style="font-size:0.65rem;letter-spacing:1px;color:var(--text-secondary);">
                                    STATUT
                                </th>
                                <th class="px-4 py-3 text-uppercase small fw-bold text-end"
                                    style="font-size:0.65rem;letter-spacing:1px;color:var(--text-secondary);">
                                    ACTIONS
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for h in historiques %}
                                <tr class="border-bottom"
                                    style="border-color:var(--border-color) !important;">

                                    {# Date / heure #}
                                    <td class="px-4 py-3"
                                        style="color:var(--text-secondary);font-size:0.85rem;white-space:nowrap;">
                                        {{ h.dateImportation|date('d/m/Y, H:i') }}
                                    </td>

                                    {# Nom du fichier - cliquable pour prévisualisation #}
                                    <td class="px-4 py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            {# Icône format #}
                                            {% set fmtIcons = {
                                                'json': 'fa-file-code',
                                                'csv':  'fa-file-csv',
                                                'xlsx': 'fa-file-excel',
                                                'xls':  'fa-file-excel'
                                            } %}
                                            {% set fmtColors = {
                                                'json': '#f0a500',
                                                'csv':  '#00ffa3',
                                                'xlsx': '#1d6f42',
                                                'xls':  '#1d6f42'
                                            } %}
                                            <i class="fas {{ fmtIcons[h.formatFichier] ?? 'fa-file' }}"
                                               style="color:{{ fmtColors[h.formatFichier] ?? '#6c757d' }};
                                                      font-size:0.95rem;"></i>
                                            <button class="btn btn-link p-0 m-0 text-start preview-btn"
                                                    data-id="{{ h.id }}"
                                                    data-filename="{{ h.nomFichier }}"
                                                    style="color:var(--text-primary);text-decoration:none;
                                                           font-weight:600;font-size:0.9rem;border:none;
                                                           background:transparent;cursor:pointer;"
                                                    onmouseover="this.style.color='var(--emerald)';"
                                                    onmouseout="this.style.color='var(--text-primary)';">
                                                <span style="border-bottom:1px dashed var(--border-color);">
                                                    {{ h.nomFichier }}
                                                </span>
                                                <i class="fas fa-eye ms-1" style="font-size:0.7rem;color:var(--text-secondary);"></i>
                                            </button>
                                        </div>
                                    </td>

                                    {# Résultats #}
                                    <td class="px-4 py-3" style="font-size:0.85rem;">
                                        <span style="color:var(--text-secondary);">
                                            {{ h.nombreLignes }} ligne{{ h.nombreLignes > 1 ? 's' : '' }}
                                        </span>
                                        {% if h.nombreErreurs > 0 %}
                                            <span class="ms-2"
                                                  style="color:#dc3545;font-size:0.75rem;">
                                                ({{ h.nombreErreurs }} erreur{{ h.nombreErreurs > 1 ? 's' : '' }})
                                            </span>
                                        {% endif %}
                                        {% if h.statut == 'echec' and h.nombreLignes == 0 %}
                                            <span style="color:#dc3545;">(Format invalide)</span>
                                        {% endif %}
                                    </td>

                                    {# Statut badge #}
                                    <td class="px-4 py-3">
                                        {% if h.statut == 'succes' %}
                                            <span class="d-flex align-items-center gap-1 fw-semibold"
                                                  style="color:#28a745;font-size:0.88rem;">
                                                <i class="fas fa-circle" style="font-size:0.5rem;"></i>
                                                Réussi
                                            </span>
                                        {% elseif h.statut == 'succes_avec_warnings' %}
                                            <span class="d-flex align-items-center gap-1 fw-semibold"
                                                  style="color:#d4a017;font-size:0.88rem;">
                                                <i class="fas fa-exclamation-triangle" style="font-size:0.5rem;"></i>
                                                Réussi ⚠️
                                            </span>
                                        {% elseif h.statut == 'partiel' %}
                                            <span class="d-flex align-items-center gap-1 fw-semibold"
                                                  style="color:#f0a500;font-size:0.88rem;">
                                                <i class="fas fa-circle" style="font-size:0.5rem;"></i>
                                                Partiel
                                            </span>
                                        {% elseif h.statut == 'echec' %}
                                            <span class="d-flex align-items-center gap-1 fw-semibold"
                                                  style="color:#dc3545;font-size:0.88rem;">
                                                <i class="fas fa-circle" style="font-size:0.5rem;"></i>
                                                Échoué
                                            </span>
                                        {% else %}
                                            <span class="d-flex align-items-center gap-1 fw-semibold"
                                                  style="color:#6c757d;font-size:0.88rem;">
                                                <i class="fas fa-circle fa-spin" style="font-size:0.5rem;"></i>
                                                En cours
                                            </span>
                                        {% endif %}
                                    </td>

                                    {# Actions #}
                                    <td class="px-4 py-3 text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a href="{{ path('app_historique_importation_download', {'id': h.id}) }}"
                                               class="btn btn-sm rounded-circle"
                                               style="width:34px;height:34px;
                                                      border:1.5px solid rgba(100,180,255,0.3);
                                                      color:#64b4ff;background:rgba(100,180,255,0.06);"
                                               title="Télécharger le fichier original"
                                               onmouseover="this.style.borderColor='#64b4ff';this.style.background='rgba(100,180,255,0.15)';"
                                               onmouseout="this.style.borderColor='rgba(100,180,255,0.3)';this.style.background='rgba(100,180,255,0.06)';">
                                                <i class="fas fa-download" style="font-size:0.8rem;"></i>
                                            </a>
                                            <a href="{{ path('app_historique_importation_show', {'id': h.id}) }}"
                                               class="btn btn-sm rounded-circle journal-btn"
                                               style="width:34px;height:34px;
                                                      border:1.5px solid var(--border-color);
                                                      color:var(--text-secondary);background:transparent;"
                                               title="Voir le journal"
                                               onmouseover="this.style.borderColor='var(--emerald)';this.style.color='var(--emerald)';"
                                               onmouseout="this.style.borderColor='var(--border-color)';this.style.color='var(--text-secondary)';">
                                                <i class="fas fa-file-lines" style="font-size:0.8rem;"></i>
                                            </a>
                                        </div>
                                    </td>

                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

        </div>
    </div>

</div>

{# ── MODAL DE PRÉVISUALISATION ────────────────────────────────── #}
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content rounded-4 border-0"
             style="background:var(--card-bg-light);border:1px solid var(--border-color) !important;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" style="color:var(--text-primary);">
                    <i class="fas fa-file-import me-2" style="color:#64b4ff;"></i>
                    Prévisualisation du fichier : <span id="previewFilename" style="color:var(--emerald);"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        style="filter:invert(1);opacity:0.5;"></button>
            </div>
            <div class="modal-body pt-3">
                <div id="previewLoading" class="text-center py-5" style="color:var(--text-secondary);">
                    <i class="fas fa-spinner fa-spin fa-3x mb-3"></i>
                    <p>Chargement du fichier...</p>
                </div>
                <div id="previewContent" style="display:none;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge" id="previewFormat" style="background:rgba(0,255,163,0.1);color:var(--emerald);"></span>
                        <div>
                            <button type="button" id="previewDownloadBtn" class="btn btn-sm"
                                    style="background:rgba(100,180,255,0.1);color:#64b4ff;
                                           border:1px solid rgba(100,180,255,0.3);border-radius:8px;">
                                <i class="fas fa-download me-1"></i> Télécharger
                            </button>
                        </div>
                    </div>
                    <div id="previewFileContent" style="max-height:500px;overflow:auto;
                          background:var(--bg-body);border-radius:12px;
                          padding:16px;border:1px solid var(--border-color);">
                    </div>
                </div>
                <div id="previewError" style="display:none;" class="text-center py-5">
                    <i class="fas fa-exclamation-triangle fa-3x mb-3" style="color:#dc3545;"></i>
                    <p style="color:var(--text-secondary);">Impossible de charger le fichier.</p>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm px-4"
                        data-bs-dismiss="modal"
                        style="background:transparent;border:1.5px solid var(--border-color);
                               color:var(--text-secondary);border-radius:10px;">
                    Fermer
                </button>
            </div>
        </div>
    </div>
</div>

{# Formulaire caché pour vider l'historique #}
<form id="clearForm"
      action="{{ path('app_historique_importation_clear') }}"
      method="POST" class="d-none">
    <input type="hidden" name="_token"
           value="{{ csrf_token('clear_historique') }}">
</form>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {

    // ── Prévisualisation du fichier ─────────────────────────────────────
    const previewModal = new bootstrap.Modal(document.getElementById('previewModal'));
    const previewBtns = document.querySelectorAll('.preview-btn');

    previewBtns.forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.dataset.id;
            const filename = this.dataset.filename;

            document.getElementById('previewFilename').textContent = filename;
            document.getElementById('previewLoading').style.display = 'block';
            document.getElementById('previewContent').style.display = 'none';
            document.getElementById('previewError').style.display = 'none';

            previewModal.show();

            // Charger le contenu
            fetch('/historique-importation/' + id + '/preview')
                .then(response => response.json())
                .then(data => {
                    document.getElementById('previewLoading').style.display = 'none';

                    if (!data.success) {
                        document.getElementById('previewError').style.display = 'block';
                        return;
                    }

                    document.getElementById('previewContent').style.display = 'block';
                    document.getElementById('previewFormat').textContent = data.format.toUpperCase();

                    // Afficher le contenu selon le format
                    const contentDiv = document.getElementById('previewFileContent');

                    if (data.isCsv && data.previewData && data.previewData.length > 0) {
                        // Affichage CSV en tableau
                        let html = '<div class="table-responsive"><table class="table table-sm table-hover" style="color:var(--text-primary);font-size:0.85rem;">';
                        // En-têtes
                        const headers = Object.keys(data.previewData[0]);
                        html += '<thead><tr>';
                        headers.forEach(h => {
                            html += `<th style="color:var(--text-secondary);font-weight:600;">${h}</th>`;
                        });
                        html += '</tr></thead><tbody>';
                        // Données
                        data.previewData.forEach(row => {
                            html += '<tr>';
                            headers.forEach(h => {
                                html += `<td>${row[h] || ''}</td>`;
                            });
                            html += '</tr>';
                        });
                        html += '</tbody></table></div>';
                        contentDiv.innerHTML = html;
                    } else if (data.isJson) {
                        // Affichage JSON formaté
                        const formatted = data.content;
                        contentDiv.innerHTML = `<pre style="margin:0;color:var(--text-secondary);font-size:0.85rem;white-space:pre-wrap;">${formatted}</pre>`;
                    } else {
                        // Affichage texte brut
                        contentDiv.innerHTML = `<pre style="margin:0;color:var(--text-secondary);font-size:0.85rem;white-space:pre-wrap;">${data.content}</pre>`;
                    }

                    // Téléchargement depuis la modale
                    document.getElementById('previewDownloadBtn').onclick = function() {
                        window.location.href = '/historique-importation/' + id + '/download';
                    };

                })
                .catch(error => {
                    document.getElementById('previewLoading').style.display = 'none';
                    document.getElementById('previewError').style.display = 'block';
                    console.error('Erreur:', error);
                });
        });
    });

    // ── Confirmation de vidage ─────────────────────────────────────────
    window.confirmClear = function() {
        Swal.fire({
            title: 'Vider l\'historique ?',
            html: `<div style="text-align:left;">
                <p style="color:var(--text-secondary);">
                    Toutes les entrées d'historique seront <strong style="color:#dc3545;">définitivement supprimées</strong>.
                </p>
                <p style="font-size:0.9rem;color:var(--text-secondary);">
                    <i class="fas fa-info-circle" style="color:#64b4ff;"></i>
                    Les produits importés ne seront <strong>pas</strong> supprimés.
                </p>
            </div>`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: '<i class="fas fa-trash me-1"></i> Vider',
            cancelButtonText: '<i class="fas fa-times me-1"></i> Annuler',
            background: getComputedStyle(document.documentElement)
                .getPropertyValue('--card-bg-light').trim() || '#fff',
            color: getComputedStyle(document.documentElement)
                .getPropertyValue('--text-primary').trim() || '#111',
            customClass: {
                popup: 'rounded-4',
                confirmButton: 'btn btn-danger px-4 py-2 rounded-pill',
                cancelButton:  'btn btn-secondary px-4 py-2 rounded-pill',
            }
        }).then(r => { if (r.isConfirmed) document.getElementById('clearForm').submit(); });
    };
});
</script>

<style>
    .table > :not(caption) > * > * { background-color: transparent !important; }
    .table-hover tbody tr:hover     { background: var(--bg-body) !important; }

    .journal-btn:hover {
        border-color: var(--emerald) !important;
        color: var(--emerald) !important;
    }

    .preview-btn:hover .fa-eye {
        color: var(--emerald) !important;
    }

    /* Alignement point de statut */
    .fa-circle { vertical-align: middle; }

    .swal2-popup {
        border-radius: 16px !important;
        border: 1px solid var(--border-color) !important;
    }
    .swal2-confirm, .swal2-cancel {
        border: none !important;
        border-radius: 50px !important;
        font-weight: 600 !important;
        padding: 0.6rem 1.5rem !important;
    }
    .swal2-cancel { background: #6c757d !important; }
    .swal2-actions { gap: 0.75rem !important; }

    /* Scrollbar personnalisée pour la prévisualisation */
    #previewFileContent::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }
    #previewFileContent::-webkit-scrollbar-track {
        background: var(--bg-body);
        border-radius: 4px;
    }
    #previewFileContent::-webkit-scrollbar-thumb {
        background: var(--border-color);
        border-radius: 4px;
    }
    #previewFileContent::-webkit-scrollbar-thumb:hover {
        background: var(--text-secondary);
    }
</style>
{% endblock %}
