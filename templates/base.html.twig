            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-3">
                    <div class="bg-emerald-10 rounded-circle p-2">
                        <i class="fas fa-check-circle text-emerald"></i>
                    </div>
                    <div>
                        <strong class="toast-title" id="toastTitle" style="color: var(--text-primary);">Système</strong>
                        <p class="mb-0 small" id="toastMessage" style="color: var(--text-secondary);">Action effectuée avec succès.</p>
                    </div>
